config {
  type: "view",
  schema: constants.SCHEMAS.dv360_staging,
  name: "stg_dv360_audience",
  tags: ["dv360", "staging"],
  description: "DV360 audience delivery: line item x audience category x day. IMPRESSIONS ONLY — the source carries no spend and no clicks, so this answers who saw an ad and never what it cost.",
  columns: {
    audience_category: "DV360's own audience segment label. The only audience data anywhere in this warehouse — Google Ads has criterion ids with no names, and Meta and TikTok have none at all.",
    impressions: "Arrives as FLOAT64 here while fct_dv360_lineitem gives INT64. Cast so the mart matches every other impressions column in the project.",
    campaign_id: "NOT IN THIS SOURCE. It carries insertion order and line item but no campaign. Join dim_dv360_line_item to get campaign and partner."
  }
}

-- Appeared 2026-10-13 with the new DV360 table set, 529,923 rows over 14
-- days. Nothing like it existed before.
--
-- NON-ADDITIVE ACROSS CATEGORIES. One impression can match several
-- audience segments, so summing across audience_category will exceed the
-- line item's real impressions. Compare categories against each other;
-- never total them. Same rule as Meta's breakdowns.

SELECT
  ${metrics.parseSlashDate("Date")} AS date,
  Partner_ID                        AS partner_id,
  Partner                           AS partner,
  Advertiser_ID                     AS advertiser_id,
  Advertiser                        AS advertiser,
  Advertiser_Currency               AS advertiser_currency,
  Insertion_Order_ID                AS insertion_order_id,
  Insertion_Order                   AS insertion_order,
  Line_Item_ID                      AS line_item_id,
  Line_Item                         AS line_item,
  Line_Item_Type                    AS line_item_type,
  Category                          AS audience_category,
  CAST(Impressions AS INT64)        AS impressions
FROM ${ref({ schema: constants.DATASETS.kebooladv, name: "fct_dv360_audience" })}
WHERE Date IS NOT NULL
