config {
  type: "view",
  schema: constants.SCHEMAS.dv360_staging,
  name: "stg_dv360_creative",
  tags: ["dv360", "staging"],
  description: "DV360 creative breakdown. Covers ~85% of spend — DV360 omits impressions it cannot attribute to a named creative. Compare creatives with it, never total money. No Partner, no Campaign, no Total_Conversions (post-click + post-view only), no Invalid_Clicks."
}

SELECT
  ${metrics.parseSlashDate("Date")} AS date,
  Advertiser_ID         AS advertiser_id,
  Advertiser            AS advertiser,
  Advertiser_Currency   AS advertiser_currency,
  Insertion_Order_ID    AS insertion_order_id,
  Insertion_Order       AS insertion_order,
  Line_Item_ID          AS line_item_id,
  Line_Item             AS line_item,
  Line_Item_Type        AS line_item_type,
  Creative_ID           AS creative_id,
  Creative              AS creative,
  Creative_Asset        AS creative_asset,
  Creative_Size         AS creative_size,
  Ad_Type               AS ad_type,
  Impressions           AS impressions,
  Clicks                AS clicks,
  Engagements           AS interactions,
  Complete_Views_Video  AS complete_views,
  PostClick_Conversions AS postclick_conversions,
  PostView_Conversions  AS postview_conversions,
  Revenue_Adv_Currency  AS spend
FROM ${ref({ schema: constants.DATASETS.kebooladv, name: "fct_dv360_creative" })}
WHERE Date IS NOT NULL
-- SNAPSHOT DE-DUPLICATION, 2026-10-22. Keboola appends a new extract of a
-- row rather than replacing the previous one, so rows sharing this grain key
-- are successive readings of one cumulative figure. Summing them inflates
-- the number; the largest reading is the complete one. Measured today:
-- 13,490 rows against 10,234 distinct keys.
--
-- Twelfth table with this defect, after stg_dv360_lineitem, the six branches
-- of stg_dv360_breakdown and all four CM360 sources. Largest rather than
-- latest, because no extract carries a load timestamp.
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY Date, Line_Item_ID, Creative_ID, Creative_Asset, Creative_Size
  ORDER BY Impressions DESC, Clicks DESC
) = 1
