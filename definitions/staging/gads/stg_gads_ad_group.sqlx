config {
  type: "view",
  schema: constants.SCHEMAS.gads_staging,
  name: "stg_gads_ad_group",
  tags: ["gads", "staging"],
  description: "Google Ads ad group entity. Verified 2026-09-23: 62,613 rows, 62,613 distinct ids, so no de-duplication. This table has no _weld_deleted_at column.",
  columns: {
    adgroup_type: "SEARCH_STANDARD, DISPLAY_STANDARD, VIDEO_*, SHOPPING_* and so on. Performance Max campaigns have NO ad groups at all, so they never appear here."
  }
}

SELECT
  CAST(id AS STRING)          AS adgroup_id,
  CAST(account_id AS STRING)  AS account_id,
  CAST(campaign_id AS STRING) AS campaign_id,
  name                        AS adgroup_name,
  campaign_name,
  type                        AS adgroup_type,
  status                      AS adgroup_status,
  ad_rotation_mode,
  final_url_suffix,
  tracking_url_template,
  CAST(base_ad_group_id AS STRING) AS base_adgroup_id
FROM ${ref({ schema: constants.DATASETS.gads, name: "ad_group" })}
