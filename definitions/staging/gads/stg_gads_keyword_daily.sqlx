config {
  type: "view",
  schema: constants.SCHEMAS.gads_staging,
  name: "stg_gads_keyword_daily",
  tags: ["gads", "staging"],
  description: "Google Ads keyword performance BY DAY, at keyword x device x network. The keyword is a bare criterion_id since 2026-11-20 — there is no longer any source of keyword text in this warehouse.",
  columns: {
    criterion_id: "Unique only WITH adgroup_id. A NUMBER AND NOTHING ELSE since 2026-11-20, when google_ads.ad_group_criterion was dropped — nothing left in this project can turn it into the keyword someone actually bid on.",
    device: "Part of the grain: MOBILE, DESKTOP, TABLET, CONNECTED_TV, OTHER.",
    ad_network_type: "Part of the grain. Same nine values campaign_stats uses."
  }
}

-- EVERY ID IS A STRING IN THIS TABLE. keyword_stats is the only table in
-- google_ads that delivers customer_id, campaign_id, ad_group_id and
-- ad_group_criterion_criterion_id as STRING rather than INT64. The casts
-- below are therefore no-ops that exist to make that explicit, and to
-- survive Weld changing its mind.
--
-- NOTHING READS THIS ANY MORE, since 2026-11-20. It fed
-- fct_gads_keyword_daily, which fed v_keyword_daily, which labelled each
-- criterion_id with its keyword text and Quality Score from
-- dim_gads_keyword. google_ads.ad_group_criterion was the only source of
-- either, Weld had been syncing 4.5M rows for it, and the account owner
-- switched it off on purpose, so those three models were removed.
--
-- What is left here is spend against identifiers no one can read. It is
-- kept because keyword_stats is still synced and still correct, so
-- restoring the labels is a matter of declaring one source again rather
-- than rebuilding the chain. If that is not going to happen, this and
-- fct_gads_keyword_daily should go too.

SELECT
  DATE(date)                                        AS date,
  CAST(customer_id AS STRING)                       AS account_id,
  CAST(campaign_id AS STRING)                       AS campaign_id,
  CAST(ad_group_id AS STRING)                       AS adgroup_id,
  CAST(ad_group_criterion_criterion_id AS STRING)   AS criterion_id,
  device,
  ad_network_type,

  impressions,
  clicks,
  interactions,
  conversions,
  conversions_value,
  view_through_conversions,
  ${metrics.micros("cost_micros")}                  AS spend,

  active_view_impressions,
  active_view_measurable_impressions,
  ${metrics.micros("active_view_measurable_cost_micros")} AS active_view_measurable_spend,

  -- describes WHAT interactions counted for this keyword's campaign type.
  -- Not a reporting dimension, not part of the grain.
  interaction_event_types                           AS src_interaction_event_types
FROM ${ref({ schema: constants.DATASETS.gads, name: "keyword_stats" })}
WHERE _weld_deleted_at IS NULL
