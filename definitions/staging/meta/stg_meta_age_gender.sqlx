config {
  type: "view",
  schema: constants.SCHEMAS.meta_staging,
  name: "stg_meta_age_gender",
  tags: ["meta", "staging"],
  description: "Meta age x gender at CAMPAIGN x DAY. The only Meta demographic source carrying campaign_id — every demographics_* table stops at account level.",
  columns: {
    campaign_id: "What makes this table worth having. No demographics_* table has it.",
    clicks_all: "ALL-INTERACTION clicks, Meta's `clicks`. NOT link clicks — the source carries no inline_link_clicks, so CTR and CPC here are NOT comparable with v_ad_daily, which uses link_clicks."
  }
}

-- DAILY SINCE 2026-10-12. Weld switched this custom report to
-- time_increment: 1 and the schema changed with it: date_start and
-- date_stop are gone, replaced by a single `date`.
--
-- What it used to be, and why the old code looked the way it did: every
-- row was a ROLLING 7-DAY WINDOW, with a new window starting every day, so
-- each day's spend appeared in seven rows. SUM(spend) over the whole table
-- returned 29.2M against a true figure near 4M. Staging kept only Monday
-- starts, which tile the calendar exactly once.
--
-- None of that is needed now. Verified 2026-10-12: 600,800 rows, 105 days
-- from 2026-06-30, spend 4,456,568.88 -- about 42k/day, consistent with the
-- 37,867 measured for a single day in September.
--
-- assert_meta_age_gender_grain now watches for duplicates instead of for
-- window length. If Weld ever reverts, date_start/date_stop come back and
-- this view fails on a missing column, which is loud enough.

SELECT
  DATE(date)                   AS date,
  CAST(account_id  AS STRING)  AS account_id,
  CAST(campaign_id AS STRING)  AS campaign_id,
  campaign_name                AS campaign_name_raw,
  age,
  gender,
  CAST(spend       AS NUMERIC) AS spend,
  CAST(impressions AS INT64)   AS impressions,
  CAST(clicks      AS INT64)   AS clicks_all
FROM ${ref({ schema: constants.DATASETS.meta, name: "age_gender" })}
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY DATE(date), CAST(campaign_id AS STRING), age, gender
  ORDER BY _weld_synced DESC
) = 1
