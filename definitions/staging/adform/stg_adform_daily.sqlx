config {
  type: "view",
  schema: constants.SCHEMAS.adform_staging,
  name: "stg_adform_daily",
  tags: ["adform", "staging"],
  description: "Adform delivery at day x campaign x line item x creative type. Reads stg_adform_v2 since 2026-11-16 -- the three v2 reports joined -- and has nothing left to de-duplicate. The reach columns are deliberately NOT here; see stg_adform_reach.",
  columns: {
    cost: "EUR. Adform is one of the three channels that needs no conversion at all.",
    ad_creative_type: "A single value, 'Pixel Tag', on every row. Both marts GROUP BY date + campaign + line item WITHOUT it, so a line-item day carrying two types would silently sum them. assert_adform_v2_grain fails if that ever happens."
  }
}

-- REPOINTED TO stg_adform_v2 ON 2026-11-16, AND THE CONDITIONAL
-- DE-DUPLICATION CAME OUT WITH IT.
--
-- WHAT THIS FILE USED TO DO. adform_reports_combined carried 6,552 rows
-- for 842 keys. Most of the extra rows were byte-identical and fell to
-- SELECT DISTINCT, but 109 keys held rows that DIFFER, and they do not
-- differ like two readings of the same number -- they GROW. Line item
-- 15048077 on 11-10 reads 357, then 4,301, then 8,245 impressions for
-- the same day, each step exactly 3,944 above the last.
--
-- The rule here was: exact doubling -> keep the smaller, anything else
-- -> keep the larger. It handled the doubled pairs and had no answer for
-- the triples, so it kept 8,245 where 3,944 was delivered. The mart
-- carried 96,153 impressions and 623.24 EUR for campaign 4288223 on
-- 11-10 against the 44,768 and 285.74 EUR the v2 reports agree on. A
-- factor of 2.15, on money.
--
-- WHY NO TIEBREAK COULD HAVE WORKED. Adform publishes delivery and the
-- two user-de-duplicated impression counts as three separate reports
-- sharing one grain. Keboola was combining them with UNION ALL, which
-- stacks three different meanings of `impressions` into three rows per
-- key. None of the three rows is the right answer on its own, so there
-- was nothing correct to select. stg_adform_v2 joins them instead.
--
-- NO QUALIFY AND NO DISTINCT NOW, DELIBERATELY. The three sources hold
-- one row per key. A de-duplication that currently removes nothing would
-- still be here on the day one of them starts appending, quietly
-- absorbing it. assert_adform_v2_grain turns the workflow red instead,
-- and names which of the three broke.
--
-- THE HISTORY WAS GIVEN UP ON PURPOSE. v1 held 4 campaigns over 53 days
-- from 09-21; the v2 reports hold 2 campaigns over 7 days from 11-10,
-- and the marts are type: "table", so the older days left the warehouse
-- the moment this changed. That was the explicit call: v1's numbers were
-- wrong in both directions -- 2.15x too high on 11-10, 7.5x too LOW on
-- 11-12 where the feed froze mid-day, and absent after it. A short
-- correct series beats a long wrong one. Backfill is a separate question
-- for Keboola, not a reason to keep reading a broken table.

SELECT
  date,
  campaign_id,
  campaign_name,
  line_item_id,
  line_item_name,
  client_name,
  currency,
  ad_creative_type,

  impressions,
  clicks,
  cost
FROM ${ref("stg_adform_v2")}
