config {
  type: "view",
  schema: constants.SCHEMAS.cm360_staging,
  name: "stg_cm360_united",
  tags: ["cm360", "staging"],
  description: "CM360 delivery at DAY x placement x ad x creative x country x city, WITH NAMES. The first CM360 source carrying advertiser, campaign, site, placement, ad and creative names on the same row as the metrics — and the first with geography.",
  columns: {
    site_name: "Direct from the source. seed_site exists only because no earlier CM360 table had this; 69 rows of hand-maintained lookup are no longer the only route to a site name.",
    country: "CM360 geography, which did not exist in this warehouse before 2026-10-12.",
    city: "Finer than country. Expect a long tail and a lot of nulls.",
    media_cost: "Still the same unresolved column as everywhere else in CM360 — see the README. Moving dataset did not change what it means."
  }
}

-- Arrived 2026-10-12 with the move to keboola_cm360, 235,821 rows and the
-- largest CM360 table. DAILY, not hourly: use cm360_hourly for dayparting
-- and this for everything else.
--
-- SAME SPEND, DIFFERENT CUT. This is cm360_hourly rolled to day and split
-- by country and city instead of hour. Never union the two, and never join
-- them on date alone.


-- COUNTS ARE CAST TO INT64. keboola_cm360 delivers impressions, clicks,
-- activeViewViewableImpressions and richMediaVideoViews as FLOAT64, where
-- the old kebooladv tables gave INT64. Without these casts the incremental
-- marts fail on insert -- "Query column 9 has type FLOAT64 which cannot be
-- inserted into column impressions, which has type INT64" -- and the
-- warehouse would end up storing counts as floats, which nothing else here
-- does. media_cost stays FLOAT64: it is money, not a count.


-- SELECT DISTINCT since 2026-10-15. The Keboola extraction began inserting
-- instead of replacing: cm360_hourly went from 82,413 rows to 268,317, with
-- 80,347 beyond its distinct date + hour + placement + ad + creative keys.
-- cm360_united 0.2%. The floodlight table was 40% duplicated until
-- cm360_floodlightsv2 replaced it on 2026-10-17; v2 is 1.3%
-- (27 rows in 2,066). Better, not fixed -- DISTINCT stays.
--
-- DISTINCT, not a QUALIFY, and the difference matters. Checked 2026-10-15:
-- every duplicate pair is IDENTICAL in every column -- same impressions,
-- cost, site, campaign and landing page. Identical rows are interchangeable,
-- so removing one cannot lose anything.
--
-- These tables carry no sync timestamp, so there is no "newest wins" tiebreak
-- available. A QUALIFY would have to pick arbitrarily, which is exactly what
-- this file's own grain note warns against.
--
-- It also keeps the right failure mode: if the source ever duplicates rows
-- that DIFFER, DISTINCT keeps both and assert_cm360_hourly_grain fires. The
-- fix defends against the known problem without hiding a new one.

SELECT DISTINCT
  CAST(profileId AS STRING)         AS profile_id,
  profileName                       AS profile_name,
  ${metrics.parseCm360Date("date")} AS date,

  CAST(advertiserId AS STRING)      AS advertiser_id,
  NULLIF(TRIM(advertiser), '')      AS advertiser_name,
  CAST(campaignId   AS STRING)      AS campaign_id,
  NULLIF(TRIM(campaign), '')        AS campaign_name,
  CAST(siteId       AS STRING)      AS site_id,
  NULLIF(TRIM(site), '')            AS site_name,
  CAST(placementId  AS STRING)      AS placement_id,
  NULLIF(TRIM(placement), '')       AS placement_name,
  CAST(adId         AS STRING)      AS ad_id,
  NULLIF(TRIM(ad), '')              AS ad_name,
  CAST(creativeId   AS STRING)      AS creative_id,
  NULLIF(TRIM(creative), '')        AS creative_name,
  NULLIF(TRIM(landingPageUrl), '')  AS landing_page_url,

  NULLIF(TRIM(country), '')         AS country,
  NULLIF(TRIM(city), '')            AS city,

  CAST(impressions                   AS INT64) AS impressions,
  CAST(clicks                        AS INT64) AS clicks,
  CAST(activeViewViewableImpressions AS INT64) AS viewable_impressions,
  CAST(richMediaVideoViews           AS INT64) AS video_views,
  mediaCost                         AS media_cost,

  activeViewPercentageViewableImpressions AS src_pct_viewable,
  effectiveCpm                            AS src_effective_cpm
FROM ${ref({ schema: constants.DATASETS.cm360, name: "cm360_united" })}
