config {
  type: "view",
  schema: constants.SCHEMAS.cm360_staging,
  name: "stg_cm360_hourly",
  tags: ["cm360", "staging"],
  description: "CM360 backbone: every dimension CM360 gives us lives here, at date + hour + placement + ad + creative grain.",
  columns: {
    hour: "0-23, pulled out of the extractor's STRING hour column",
    src_pct_viewable: "Row-level audit only. NON-ADDITIVE — never SUM or AVG it.",
    src_effective_cpm: "Row-level audit only. NON-ADDITIVE — the reporting layer recomputes CPM from media_cost and impressions."
  }
}


-- COUNTS ARE CAST TO INT64. keboola_cm360 delivers impressions, clicks,
-- activeViewViewableImpressions and richMediaVideoViews as FLOAT64, where
-- the old kebooladv tables gave INT64. Without these casts the incremental
-- marts fail on insert -- "Query column 9 has type FLOAT64 which cannot be
-- inserted into column impressions, which has type INT64" -- and the
-- warehouse would end up storing counts as floats, which nothing else here
-- does. media_cost stays FLOAT64: it is money, not a count.


-- SELECT DISTINCT since 2026-10-15. The Keboola extraction began inserting
-- instead of replacing: cm360_hourly went from 82,413 rows to 268,317, with
-- 80,347 beyond its distinct date + hour + placement + ad + creative keys.
-- cm360_united 0.2%. The floodlight table was 40% duplicated until
-- cm360_floodlightsv2 replaced it on 2026-10-17; v2 is 1.3%
-- (27 rows in 2,066). Better, not fixed -- DISTINCT stays.
--
-- DISTINCT, not a QUALIFY, and the difference matters. Checked 2026-10-15:
-- every duplicate pair is IDENTICAL in every column -- same impressions,
-- cost, site, campaign and landing page. Identical rows are interchangeable,
-- so removing one cannot lose anything.
--
-- These tables carry no sync timestamp, so there is no "newest wins" tiebreak
-- available. A QUALIFY would have to pick arbitrarily, which is exactly what
-- this file's own grain note warns against.
--
-- It also keeps the right failure mode: if the source ever duplicates rows
-- that DIFFER, DISTINCT keeps both and assert_cm360_hourly_grain fires. The
-- fix defends against the known problem without hiding a new one.

SELECT DISTINCT
  CAST(profileId AS STRING)                                  AS profile_id,
  profileName                                                AS profile_name,

  ${metrics.parseCm360Date("date")}                          AS date,

  -- hour arrives as STRING; pull the leading integer, 0-23.
  --
  -- NO BACKSLASHES, on purpose. Whether a .sqlx body escapes them is not
  -- worth betting a silent NULL column on, so this uses [0-9] instead of
  -- the d shorthand. The trailing (?:[^0-9]|$) means a value that is not
  -- an hour — a full timestamp, say — yields NULL rather than quietly
  -- extracting the first two digits of the year.
  SAFE_CAST(REGEXP_EXTRACT(TRIM(hour), r'^([0-9]{1,2})(?:[^0-9]|$)') AS INT64) AS hour,

  -- every ID becomes STRING so joins never fight INT64 vs STRING
  CAST(advertiserId AS STRING)                               AS advertiser_id,
  CAST(campaignId   AS STRING)                               AS campaign_id,
  CAST(siteId       AS STRING)                               AS site_id,
  CAST(placementId  AS STRING)                               AS placement_id,
  CAST(adId         AS STRING)                               AS ad_id,
  CAST(creativeId   AS STRING)                               AS creative_id,
  NULLIF(TRIM(landingPageUrl), '')                           AS landing_page_url,

  -- additive metrics, kept raw
  CAST(impressions                   AS INT64)               AS impressions,
  CAST(clicks                        AS INT64)               AS clicks,
  CAST(activeViewViewableImpressions AS INT64)               AS viewable_impressions,
  CAST(richMediaVideoViews           AS INT64)               AS video_views,
  mediaCost                                                  AS media_cost,

  -- NON-additive, kept only for row-level audit
  activeViewPercentageViewableImpressions                    AS src_pct_viewable,
  effectiveCpm                                               AS src_effective_cpm

FROM ${ref({ schema: constants.DATASETS.cm360, name: "cm360_hourly" })}

-- QUALIFY ENABLED 2026-10-21, on evidence. This block sat here commented
-- out with the instruction not to add it pre-emptively. That was right: an
-- arbitrary tiebreak on a clean table silently deletes legitimate rows.
-- The evidence arrived today.
--
-- The rows that share this grain key are SNAPSHOTS, not fragments. Measured
-- on stg_cm360_hourly: placement 456459180 on 2026-10-13 hour 7 carries 189
-- and 190 impressions; placement 416384049 hour 13 carries 3,194 / 3,195 /
-- 3,196; placement 451090098 hour 22 carries 39 and 40. Each is a successive
-- reading of one cumulative figure, so the largest is the complete one and
-- SUMMING them inflates the hour.
--
-- This is the same defect found in DV360 the same day (see
-- stg_dv360_lineitem) -- Keboola appending a new extract instead of
-- replacing the old one -- and it is almost certainly the whole of the
-- hourly-vs-daily disagreement recorded as cm360_unreliable_since_2026_10_06:
-- fct_cm360_placement_hourly sums the snapshots, cm360_united does not, and
-- the two reports drifted 6.9% apart from the day the duplication started.
-- They had agreed to 144 impressions in 21.4 million before that.
--
-- SELECT DISTINCT above is now redundant -- QUALIFY already reduces each key
-- to one row -- but it is kept: it costs nothing, and it documents that the
-- byte-identical duplicates are a separate, earlier symptom of the same
-- upstream fault.
--
-- Largest rather than latest, because the extract carries no load timestamp.
-- If Keboola ever adds one, order by it instead: that is the thing this
-- approximates.
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY date, hour, placementId, adId, creativeId
  ORDER BY impressions DESC, clicks DESC, mediaCost DESC
) = 1
