config {
  type: "view",
  schema: constants.SCHEMAS.cm360_staging,
  name: "stg_cm360_floodlight",
  tags: ["cm360", "staging"],
  description: "CM360 Floodlight conversions at activity x placement x ad x creative x day. Replaces the old cm360_standard_table, which gave a single collapsed totalConversions and nothing else.",
  columns: {
    floodlight_impressions: "Impressions ATTRIBUTED WITHIN THE FLOODLIGHT REPORT. Not the same as delivery impressions in cm360_hourly or cm360_united — do not compare the two without knowing which question is being asked.",
    activity: "The Floodlight activity name — what the conversion actually was. The old standard report had no equivalent; every conversion was one undifferentiated number.",
    view_through_conversions: "Conversions credited to an IMPRESSION with no click. A separate path from click-through — never add the two and call it total, use total_conversions.",
    click_through_conversions: "Conversions credited to a CLICK.",
    total_conversions: "Google's own total. Not necessarily view_through + click_through — let it be the total rather than deriving one."
  }
}

-- Arrived 2026-10-12 with the move to keboola_cm360, where it jumped from
-- 23 rows to 2,026. The README and CATALOG both describe CM360 floodlight
-- data as empty; that is no longer true.
--
-- Unlike cm360_standard_table this carries advertiserId, so the advertiser
-- name no longer has to be bridged through cm360_reach.


-- SELECT DISTINCT since 2026-10-15. The Keboola extraction began inserting
-- instead of replacing: cm360_hourly went from 82,413 rows to 268,317, with
-- 80,347 beyond its distinct date + hour + placement + ad + creative keys.
-- cm360_united 0.2%. The floodlight table was 40% duplicated until
-- cm360_floodlightsv2 replaced it on 2026-10-17; v2 is 1.3%
-- (27 rows in 2,066). Better, not fixed -- DISTINCT stays.
--
-- DISTINCT, not a QUALIFY, and the difference matters. Checked 2026-10-15:
-- every duplicate pair is IDENTICAL in every column -- same impressions,
-- cost, site, campaign and landing page. Identical rows are interchangeable,
-- so removing one cannot lose anything.
--
-- These tables carry no sync timestamp, so there is no "newest wins" tiebreak
-- available. A QUALIFY would have to pick arbitrarily, which is exactly what
-- this file's own grain note warns against.
--
-- It also keeps the right failure mode: if the source ever duplicates rows
-- that DIFFER, DISTINCT keeps both and assert_cm360_hourly_grain fires. The
-- fix defends against the known problem without hiding a new one.

SELECT DISTINCT
  CAST(profileId AS STRING)         AS profile_id,
  profileName                       AS profile_name,
  ${metrics.parseCm360Date("date")} AS date,

  CAST(advertiserId AS STRING)      AS advertiser_id,
  NULLIF(TRIM(advertiser), '')      AS advertiser_name,
  CAST(campaignId   AS STRING)      AS campaign_id,
  NULLIF(TRIM(campaign), '')        AS campaign_name,
  CAST(siteId       AS STRING)      AS site_id,
  NULLIF(TRIM(site), '')            AS site_name,
  CAST(placementId  AS STRING)      AS placement_id,
  NULLIF(TRIM(placement), '')       AS placement_name,
  CAST(adId         AS STRING)      AS ad_id,
  NULLIF(TRIM(ad), '')              AS ad_name,
  CAST(creativeId   AS STRING)      AS creative_id,
  NULLIF(TRIM(creative), '')        AS creative_name,

  CAST(activityId      AS STRING)   AS activity_id,
  NULLIF(TRIM(activity), '')        AS activity,
  CAST(activityGroupId AS STRING)   AS activity_group_id,
  NULLIF(TRIM(activityGroup), '')   AS activity_group,
  CAST(floodlightConfigId AS STRING) AS floodlight_config_id,

  -- Arrived 2026-10-16. "Floodlight Impressions" was one of the two CM360
  -- metrics on the requested list and had no source until now. v2 dropped
  -- the impressions_str twin that v1 shipped alongside it; nothing read it.
  impressions                       AS floodlight_impressions,

  -- Arrived with v2 on 2026-10-17, and the second half of the Keboola ask:
  -- Placement Start/End Date were requested for both CM360 and DV360 and
  -- had no source anywhere until now. STRING upstream, parsed with the same
  -- COALESCE helper the date column uses -- it returns NULL rather than
  -- failing when a format is unrecognised, so an upstream format change
  -- shows up as nulls here, not as a broken pipeline.
  --
  -- Only cm360_floodlightsv2 carries these. They describe a PLACEMENT, not
  -- a floodlight activity, so they belong in a placement dimension; they are
  -- staged here because this is the only table that has them.
  ${metrics.parseCm360Date("placementStartDate")} AS placement_start_date,
  ${metrics.parseCm360Date("placementEndDate")}   AS placement_end_date,

  totalConversions                  AS total_conversions,
  totalConversionsRevenue           AS total_conversions_revenue,
  activityViewThroughConversions    AS view_through_conversions,
  activityClickThroughConversions   AS click_through_conversions,
  activityViewThroughRevenue        AS view_through_revenue,
  activityClickThroughRevenue       AS click_through_revenue,

  -- stored ratios, audit only
  activityPerClick                  AS src_activity_per_click,
  activityPerThousandImpressions    AS src_activity_per_thousand_impressions
FROM ${ref({ schema: constants.DATASETS.cm360, name: "cm360_floodlightsv2" })}
