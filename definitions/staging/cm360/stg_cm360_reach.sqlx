config {
  type: "view",
  schema: constants.SCHEMAS.cm360_staging,
  name: "stg_cm360_reach",
  tags: ["cm360", "staging"],
  description: "CM360 reach and the authoritative click count, at campaign x day. Reads cm360_reachv2 since 2026-11-11 — the first CM360 source with no duplication, so the first that needs no de-duplication.",
  columns: {
    total_reach: "NON-ADDITIVE. De-duplicated by CM360 per row. Monthly reach is not the sum of daily reach.",
    is_reach_suppressed: "TRUE where CM360 returned something non-numeric — a privacy suppression, not a zero. 620 of 3,981 rows on 2026-11-11, 15.6%.",
    clicks: "THE authoritative CM360 click count. The detail reports lose clicks to their own dimension count; this one does not."
  }
}

-- REPOINTED TO cm360_reachv2 ON 2026-11-11, AND THE DE-DUPLICATION CAME OUT
-- WITH IT.
--
-- cm360_reach appended its extraction window instead of replacing it: 12,547
-- rows for 2,756 keys, 4.55 copies each. This file carried a largest-wins
-- QUALIFY to survive that, ordering by impressions because impressions climb
-- across snapshots while reach wobbles downward as CM360 refines it.
--
-- THAT QUALIFY WAS NOT FREE. Taking the maximum impressions across up to
-- seven reads overstates them, because the maximum is whichever snapshot ran
-- highest, not whichever ran last. Reconciled over the 43 overlapping days,
-- every single difference ran the same direction:
--
--   impressions   199,321,788 (v2)  vs  199,373,820 (old)   -0.03%
--   clicks            613,912       vs      613,936         -0.004%
--
-- Small, and it was a bias rather than noise. v2 has one row per key, so
-- there is nothing to choose between and nothing to bias.
--
-- NO QUALIFY AND NO DISTINCT, DELIBERATELY. 3,981 rows for 3,981 keys on
-- 2026-11-11, across all 60 days. A de-duplication that currently removes
-- nothing would still be there on the day the source changes, quietly
-- absorbing it. fct_cm360_reach_daily already asserts uniqueKey on date +
-- advertiser_id + campaign_id, so that day turns the workflow red instead.
--
-- WHAT ELSE v2 BROUGHT: 60 days where the old table held 43, 174 campaigns
-- against 156, 88 advertisers against 83, and one day fresher.
--
-- CROSS-VALIDATED AGAINST A DIFFERENT EXTRACTION. Over the full 60 days
-- cm360_basic, which is campaign x site x creative and comes through its own
-- report, totals 1,130,840 clicks. So does this. To the unit. Impressions
-- land 125 apart in 284 million.
--
-- REACH CAN EXCEED IMPRESSIONS ON 136 ROWS, and both cases are benign.
-- "DART Search" carries clicks and reach against zero impressions, because
-- CM360 only ever tracked the click -- the impression happened on Google.
-- The rest are BidManager campaigns where a modelled reach rounds about 0.1%
-- above a small impression count: 8,430 against 8,422.
--
-- STILL STRING DATE AND FLOAT CLICKS. parseCm360Date handles the first.
-- The second has no fractional values, checked, so CAST is safe. Neither is
-- worth a workaround here; both are on the list for Keboola.

SELECT
  CAST(profileId AS STRING)         AS profile_id,
  profileName                       AS profile_name,
  ${metrics.parseCm360Date("date")} AS date,
  CAST(advertiserId AS STRING)      AS advertiser_id,
  NULLIF(TRIM(advertiser), '')      AS advertiser_name,
  CAST(campaignId AS STRING)        AS campaign_id,
  NULLIF(TRIM(campaign), '')        AS campaign_name,

  -- strip thousands separators and spaces, then cast
  SAFE_CAST(REGEXP_REPLACE(uniqueReachTotalReach, r'[^0-9]', '') AS INT64) AS total_reach,
  uniqueReachTotalReach                                                    AS total_reach_raw,
  (uniqueReachTotalReach IS NOT NULL
   AND SAFE_CAST(REGEXP_REPLACE(uniqueReachTotalReach, r'[^0-9]', '') AS INT64) IS NULL)
                                                                           AS is_reach_suppressed,

  CAST(impressions AS INT64) AS impressions,
  CAST(clicks      AS INT64) AS clicks
FROM ${ref({ schema: constants.DATASETS.cm360, name: "cm360_reachv2" })}
