config {
  type: "view",
  schema: constants.SCHEMAS.taboola_staging,
  name: "stg_taboola_daily",
  tags: ["taboola", "staging"],
  description: "Taboola delivery at day x campaign. Date parsed out of a STRING timestamp, ids cast to STRING, nothing else.",
  columns: {
    date: "Parsed with SUBSTR, not SAFE_CAST — see the note in the body.",
    spend: "In USD. Taboola is the only channel here that bills in dollars.",
    visible_impressions: "Taboola's viewable impression count. A REAL denominator, so the viewability rate computed from it is the true one, unlike CM360's."
  }
}

-- THE DATE IS A STRING WITH A TIME PART.
-- Taboola delivers it as '2026-11-04 00:00:00.0'. SAFE_CAST(date AS DATE)
-- returns NULL for every single row -- measured 2026-11-05, 289 of 289 --
-- because of the time component and the trailing .0. Taking the first ten
-- characters parses all 289.
--
-- SUBSTR rather than a regex or PARSE_TIMESTAMP: it works whether or not
-- the time part is present, so a source that later starts sending a bare
-- date keeps working. Same reasoning as metrics.parseTiktokDate.
--
-- NO DE-DUPLICATION, deliberately. This source carries no extracted_at,
-- so there is no load timestamp to order on, and an arbitrary tiebreak on
-- a clean table silently deletes real rows -- the rule this repo settled
-- on in stg_tiktok_campaign_daily. Verified 2026-11-05: 289 rows for 289
-- distinct (date, campaign) keys, exactly 1:1. The uniqueKey assertion on
-- fct_taboola_campaign_daily watches that assumption instead.

SELECT
  SAFE_CAST(SUBSTR(date, 1, 10) AS DATE) AS date,
  CAST(campaign AS STRING)               AS campaign_id,
  campaign_name,
  currency,

  CAST(impressions         AS INT64)   AS impressions,
  CAST(visible_impressions AS INT64)   AS visible_impressions,
  CAST(clicks              AS INT64)   AS clicks,
  CAST(spent               AS FLOAT64) AS spend
FROM ${ref({ schema: constants.DATASETS.taboola, name: "taboola_campaign_day" })}
