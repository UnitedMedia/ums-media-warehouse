config {
  type: "view",
  schema: constants.SCHEMAS.tiktok_reporting,
  name: "v_reach_daily",
  tags: ["tiktok", "reporting"],
  description: "TikTok reach and frequency, campaign x day. Its own Looker Studio page, its own scorecards, its own data source. NEVER blend this with v_daily or v_campaign_daily: it is the same delivery counted again, and a blend fans reach out against the delivery rows so both sides lie.",
  columns: {
    reach: "NON-ADDITIVE. Set the Looker aggregation to MAX, never SUM. True for this one campaign, on this one day.",
    frequency: "Impressions per reached person, at this row's grain. To aggregate, rebuild it in Looker as SUM(impressions_same_grain) / SUM(reach) — and read the warning below before you do.",
    impressions_same_grain: "Frequency's denominator, not a delivery figure. v_campaign_daily owns impressions."
  }
}

-- WHAT THIS VIEW ANSWERS, AND WHAT IT DOES NOT.
--
--   "how often did this campaign reach a person on this day"   -> yes
--   "which day did the campaign reach most people"             -> yes
--   "how many people did this campaign reach in October"       -> NO
--
-- The last one is not a limitation of this view, it is what reach is.
-- TikTok de-duplicates within a day; a person reached on the 3rd and the
-- 9th is in both rows. Adding the days counts them twice, and there is no
-- way to know how many such people there are.
--
-- For a campaign total, use v_campaign_reach_lifetime, which carries the
-- figure TikTok itself de-duplicated over the campaign's whole life.
-- For a calendar month, TikTok has to be asked for that month.
--
-- AGGREGATING FREQUENCY NEEDS THE SAME CARE. SUM(impressions) / SUM(reach)
-- across several days is arithmetically fine and semantically wrong,
-- because the denominator counts repeat viewers once per day. It
-- understates frequency, and the more days you include the worse it gets.
-- The defensible reading of this view is row by row.

SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  f.advertiser_id,
  d.advertiser_name,
  f.campaign_id,
  d.campaign_name,
  d.objective,
  d.objective_type,
  d.campaign_status,

  f.reach,
  f.impressions_same_grain,
  ${metrics.frequency("f.impressions_same_grain", "f.reach")} AS frequency
FROM ${ref("fct_tiktok_reach_daily")} f
LEFT JOIN ${ref("dim_tiktok_campaign")} d USING (campaign_id)
