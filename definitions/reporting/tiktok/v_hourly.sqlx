config {
  type: "view",
  schema: constants.SCHEMAS.tiktok_reporting,
  name: "v_hourly",
  tags: ["tiktok", "reporting"],
  description: "TikTok dayparting: ad x hour. Its own chart and its own Looker data source — the same spend as v_daily at a finer grain, so never blend the two.",
  columns: {
    reach: "MOVED 2026-11-10. Reach per ad per HOUR was the least summable figure in the whole feed: TikTok de-duplicates inside each hour, so adding a day's 24 rows counts one person up to 24 times. Campaign x day reach is in v_reach_daily; a campaign total is in v_campaign_reach_lifetime."
  }
}

SELECT
  f.date,
  f.hour,
  d.advertiser_name,
  d.campaign_id,
  d.campaign_name,
  d.adgroup_name,
  d.ad_id,
  d.ad_name,
  d.currency,
  f.impressions,
  f.clicks,
  f.spend,
  f.conversions,
  f.results,
  f.video_plays,
  f.video_views_p100,
  ${metrics.cpm("f.spend", "f.impressions")}                       AS cpm,
  ${metrics.ctr("f.clicks", "f.impressions")}                      AS ctr,
  ${metrics.cpc("f.spend", "f.clicks")}                            AS cpc,
  ${metrics.completionRate("f.video_views_p100", "f.impressions")} AS completion_rate
FROM ${ref("fct_tiktok_ad_hourly")} f
LEFT JOIN ${ref("dim_tiktok_ad")} d USING (ad_id)
