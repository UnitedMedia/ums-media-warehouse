config {
  type: "view",
  schema: constants.SCHEMAS.tiktok_reporting,
  name: "v_daily",
  tags: ["tiktok", "reporting"],
  description: "Primary TikTok Looker Studio source. Ad x day with the full hierarchy and every calculated metric. Covers ~98.6% of spend — use v_campaign_daily for a complete total.",
  columns: {
    spend: "Advertiser currency, from dim_tiktok_ad. No TikTok report table carries a currency of its own.",
    results: "Counts whatever the campaign optimised for (objective_type). Two campaigns with different objectives have incomparable results — always show objective_type alongside.",
    reach: "NON-ADDITIVE above ad x day. Set aggregation to MAX in Looker, never SUM.",
    completion_rate: "video_views_p100 / impressions. TikTok also gives 25/50/75 quartiles for a drop-off curve."
  }
}

SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  d.advertiser_id,
  d.advertiser_name,
  d.currency,
  d.campaign_id,
  d.campaign_name,
  d.objective,
  d.objective_type,
  d.adgroup_id,
  d.adgroup_name,
  d.optimize_goal,
  d.billing_event,
  d.placement_type,
  d.ad_id,
  d.ad_name,
  d.ad_format,
  d.ad_text,
  d.call_to_action,
  d.landing_page_url,
  d.ad_status,

  f.impressions,
  f.clicks,
  f.reach,
  f.spend,
  f.conversions,
  f.results,
  f.sales_leads,
  f.purchases,
  f.purchase_value,
  f.complete_payments,
  f.likes,
  f.comments,
  f.shares,
  f.follows,
  f.profile_visits,
  f.video_plays,
  f.video_views_p25,
  f.video_views_p50,
  f.video_views_p75,
  f.video_views_p100,
  f.video_watched_2s,
  f.video_watched_6s,
  f.skan_conversions,

  ${metrics.cpm("f.spend", "f.impressions")}                       AS cpm,
  ${metrics.ctr("f.clicks", "f.impressions")}                      AS ctr,
  ${metrics.cpc("f.spend", "f.clicks")}                            AS cpc,
  ${metrics.frequency("f.impressions", "f.reach")}                 AS frequency,
  ${metrics.completionRate("f.video_views_p100", "f.impressions")} AS completion_rate,
  ${metrics.viewRate("f.video_views_p25", "f.impressions")}        AS view_rate_p25,
  ${metrics.viewRate("f.video_views_p50", "f.impressions")}        AS view_rate_p50,
  ${metrics.viewRate("f.video_views_p75", "f.impressions")}        AS view_rate_p75,
  ${metrics.interactionRate("f.likes + f.comments + f.shares", "f.impressions")} AS engagement_rate,
  ${metrics.cpa("f.spend", "f.conversions")}                       AS cost_per_conversion,
  ${metrics.cpa("f.spend", "f.results")}                           AS cost_per_result,
  ${metrics.cpa("f.spend", "f.purchases")}                         AS cost_per_purchase,
  ${metrics.roas("f.purchase_value", "f.spend")}                   AS purchase_roas
FROM ${ref("fct_tiktok_ad_daily")} f
LEFT JOIN ${ref("dim_tiktok_ad")} d USING (ad_id)
