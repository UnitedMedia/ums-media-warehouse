config {
  type: "view",
  schema: constants.SCHEMAS.teads_reporting,
  name: "v_daily",
  tags: ["teads", "reporting"],
  description: "Teads day x creative. The Looker Studio surface for the channel — roll it up to line item, campaign or advertiser in the dashboard. Every ratio here is computed over the sums, so it stays correct at whatever level Looker aggregates to.",
  columns: {
    spend: "budget_delivered, in campaign currency. The billed figure — it equals MASTER_TABLE to the cent on every day from 2026-10-01 to 10-15.",
    completion_rate: "video_completes / video_STARTS. The real VTR, because Teads delivers the start count. This is NOT the same measurement as the completion_rate in the DV360 or TikTok views, which divide by impressions because their sources give no start count.",
    viewable_rate: "viewable / MEASURABLE impressions. The true Moat viewability rate. The CM360 view's column of the same name divides by impressions and therefore reads lower; they are not comparable.",
    measurable_rate: "How much of delivery Moat could measure at all. A low value makes viewable_rate unreliable, so read it first."
  }
}

SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  f.seat_id,
  f.advertiser_id,
  f.advertiser_name,
  f.campaign_id,
  f.campaign_name,
  f.line_item_id,
  f.line_item_name,
  f.creative_id,
  f.creative_name,
  f.currency,

  f.impressions,
  f.clicks,
  f.video_starts,
  f.video_completes,
  f.spend,
  f.measurable_impressions,
  f.viewable_impressions,

  ${metrics.cpm("f.spend", "f.impressions")}                              AS cpm,
  ${metrics.ctr("f.clicks", "f.impressions")}                             AS ctr,
  ${metrics.cpc("f.spend", "f.clicks")}                                   AS cpc,
  ${metrics.viewRate("f.video_starts", "f.impressions")}                  AS start_rate,
  ${metrics.completionRate("f.video_completes", "f.video_starts")}        AS completion_rate,
  ${metrics.viewRate("f.measurable_impressions", "f.impressions")}        AS measurable_rate,
  ${metrics.viewableRate("f.viewable_impressions", "f.measurable_impressions")} AS viewable_rate,
  ${metrics.cpa("f.spend", "f.video_completes")}                          AS cost_per_completed_view,

  -- Audit only, and not next to spend. Teads' second money column,
  -- confirmed NOT to be the billed one. Kept so the divergence stays
  -- checkable without going back to the source.
  f.budget_spent                                                          AS src_budget_spent
FROM ${ref("fct_teads_creative_daily")} f
