config {
  type: "view",
  schema: constants.SCHEMAS.gads_reporting,
  name: "v_video_funnel_daily",
  tags: ["gads", "reporting"],
  description: "The Google Ads video completion funnel: 25 / 50 / 75 / 100 percent rates and TrueView views, by campaign, day and network. Spend comes from fct_gads_campaign_device_daily, the only Google Ads money source. Use v_video_daily instead when you need to compare ad FORMATS — that one is ad-level, this one has the funnel.",
  columns: {
    quartile_25_rate: "NON-ADDITIVE. Correct for this row and meaningless averaged across rows: the denominator is video impressions, which is not synced, so there is no weight to average by. Set Looker aggregation to MAX and keep campaign, day and network on the chart.",
    completion_rate: "quartile_100_rate. The headline number.",
    retention_25_to_100: "quartile_100_rate / quartile_25_rate — of the viewers who got past 25 percent, the share who finished. Both rates share the same hidden denominator, so it cancels and this ratio is exact.",
    spend: "Real per-network spend, from fct_gads_campaign_device_daily summed over devices. ADDITIVE. The video source carries an identical cost column; it is deliberately not staged.",
    cost_per_trueview_view: "spend / video_trueview_views. The number to compare campaigns on.",
    video_views: "campaign_stats.video_views, a DIFFERENT metric from video_trueview_views. Shown side by side on purpose — do not assume they agree.",
    all_conversions: "WIDER than the `conversions` column in every other Google Ads view. Different measure, not a restatement. Never add the two."
  }
}

-- fct_gads_campaign_device_daily is campaign x day x device x network, and
-- summing it equals fct_gads_campaign_daily to the cent
-- (assert_gads_device_reconciliation proves that on every run). Rolling
-- away device lands exactly on this view's grain, so the spend here is a
-- true per-network figure and stays additive.
--
-- The quartile rates do NOT become additive by sitting next to it. Their
-- denominator is video impressions, which nobody syncs.

WITH spend_by_network AS (
  SELECT
    date,
    campaign_id,
    ad_network_type,
    SUM(spend)       AS spend,
    SUM(impressions) AS impressions,
    SUM(clicks)      AS clicks,
    SUM(video_views) AS video_views
  FROM ${ref("fct_gads_campaign_device_daily")}
  GROUP BY 1, 2, 3
)
SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  f.account_id,
  c.account_name,
  c.currency,
  f.campaign_id,
  c.campaign_name,
  f.advertising_channel_type,
  f.ad_network_type,

  m.spend,
  m.impressions,
  m.clicks,
  m.video_views,

  f.video_trueview_views,
  f.engagements,
  f.all_conversions,
  f.all_conversions_value,

  f.video_quartile_p_25_rate  AS quartile_25_rate,
  f.video_quartile_p_50_rate  AS quartile_50_rate,
  f.video_quartile_p_75_rate  AS quartile_75_rate,
  f.video_quartile_p_100_rate AS completion_rate,
  SAFE_DIVIDE(f.video_quartile_p_100_rate,
              f.video_quartile_p_25_rate)             AS retention_25_to_100,

  ${metrics.cpm("m.spend", "m.impressions")}           AS cpm,
  ${metrics.cpa("m.spend", "f.video_trueview_views")}  AS cost_per_trueview_view,
  ${metrics.cpa("m.spend", "f.engagements")}           AS cost_per_engagement,
  ${metrics.cpa("m.spend", "f.all_conversions")}       AS cost_per_all_conversion
FROM ${ref("fct_gads_campaign_video_daily")} f
LEFT JOIN spend_by_network m
  ON  m.date            = f.date
  AND m.campaign_id     = f.campaign_id
  AND m.ad_network_type = f.ad_network_type
LEFT JOIN ${ref("dim_gads_campaign")} c
  ON c.campaign_id = f.campaign_id
