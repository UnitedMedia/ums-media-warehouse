config {
  type: "view",
  schema: constants.SCHEMAS.gads_reporting,
  name: "v_keyword_daily",
  tags: ["gads", "reporting"],
  description: "Google Ads keyword performance over time, WITH Quality Score attached. v_keyword_quality is today's score with no history; this is the history, labelled with that score.",
  columns: {
    quality_score: "TODAY'S score, repeated on every historical row. The source has no date, so this is a label, not a time series. A keyword whose score changed last week shows its CURRENT score on last month's rows — never chart quality_score over date.",
    is_low_quality: "quality_score <= 4, where CPC penalties bite. Combine with spend to find what is worth fixing.",
    spend: "Keywords exist only in Search and Shopping. Performance Max has none, so this covers a minority of Google Ads spend by design."
  }
}

-- WHY QUALITY SCORE IS SAFE TO JOIN HERE BUT NOT TO CHART OVER TIME.
-- dim_gads_keyword has no date: google_ads.ad_group_criterion is current
-- state. Joining it to a daily fact attaches today's score to every past
-- day. That is fine for FILTERING ("show me spend on keywords currently
-- scoring 3") and wrong for TRENDING ("quality score by month"), which
-- would draw a flat line that means nothing.
--
-- The join needs BOTH keys. criterion_id is unique only within an ad
-- group, which is what dim_gads_keyword's uniqueKey already says.

SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  f.account_id,
  c.account_name,
  c.currency,
  f.campaign_id,
  c.campaign_name,
  c.advertising_channel_type,
  f.adgroup_id,
  g.adgroup_name,

  f.criterion_id,
  k.keyword_text,
  k.keyword_match_type,
  k.quality_score,
  k.has_quality_score,
  k.quality_expected_ctr,
  k.quality_ad_relevance,
  k.quality_landing_page,
  (k.quality_score IS NOT NULL AND k.quality_score <= 4) AS is_low_quality,

  f.device,
  f.ad_network_type,

  f.impressions,
  f.clicks,
  f.interactions,
  f.conversions,
  f.conversions_value,
  f.spend,

  ${metrics.cpm("f.spend", "f.impressions")}            AS cpm,
  ${metrics.ctr("f.clicks", "f.impressions")}           AS ctr,
  ${metrics.cpc("f.spend", "f.clicks")}                 AS cpc,
  ${metrics.cpa("f.spend", "f.conversions")}            AS cpa,
  ${metrics.roas("f.conversions_value", "f.spend")}     AS roas,
  ${metrics.viewableRate("f.active_view_impressions",
                         "f.active_view_measurable_impressions")} AS viewable_rate
FROM ${ref("fct_gads_keyword_daily")} f
LEFT JOIN ${ref("dim_gads_keyword")} k
  ON  k.adgroup_id   = f.adgroup_id
  AND k.criterion_id = f.criterion_id
LEFT JOIN ${ref("dim_gads_campaign")} c ON c.campaign_id = f.campaign_id
LEFT JOIN ${ref("dim_gads_ad_group")} g ON g.adgroup_id  = f.adgroup_id
