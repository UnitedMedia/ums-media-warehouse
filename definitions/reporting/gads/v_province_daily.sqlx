config {
  type: "view",
  schema: constants.SCHEMAS.gads_reporting,
  name: "v_province_daily",
  tags: ["gads", "reporting"],
  description: "Google Ads performance by PROVINCE, with resolved place names — the drill-down below v_geo_daily, which is country. ALWAYS FILTER TO ONE location_type; the two values are two readings of the same click and summing them double counts.",
  columns: {
    location_type: "**Filter this on every chart, and DEFAULT TO LOCATION_OF_PRESENCE.** The same rule and the same asymmetry v_geo_daily documents: presence is where the user physically was and covers all delivery, interest only exists where the query named a place.",
    geo_name: "The province, resolved through dim_gads_geo. Reads geo_<id> where Google's reference list has no entry.",
    canonical_name: "Full path, e.g. 'Vojvodina,Serbia'. The one to use — a bare province name is ambiguous far more often than a country is.",
    country_name: "The country this province sits in, resolved separately so a chart can group provinces by market without a second lookup.",
    spend: "AD GROUP spend. Performance Max has no ad groups, so this never totals to Google Ads money."
  }
}

-- Rate metrics below are row-grain. In Looker rebuild them as calculated
-- fields over the additive columns -- see CATALOG.md.
--
-- THIS DOES NOT HAVE TO ADD UP TO v_geo_daily, and a chart that puts the
-- two side by side will look broken when it is not. Google places a click
-- in a country whenever it can and in a province only when it can be more
-- precise, so delivery with no province simply has no row here. Use this
-- to compare places WITHIN a market, not to reconcile against the country
-- fact.
--
-- 'PROVINCE' IS GOOGLE'S WORD AND IT IS NOT ROMANIAN COUNTIES. It is
-- whatever sub-country level each market uses -- a Belgian province, an
-- English constituent country, a Serbian autonomous province. Measured
-- 2026-11-23 the largest by spend was Vojvodina in Serbia, so a report
-- opened expecting Cluj and Timis will look empty and be correct.

SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  f.account_id,
  c.account_name,
  c.currency,
  f.campaign_id,
  c.campaign_name,
  c.advertising_channel_type,
  f.adgroup_id,
  g.adgroup_name,

  f.location_type,
  f.geo_target_id,
  t.geo_name,
  t.canonical_name,
  t.country_code,
  t.geo_target_type,
  t.is_name_missing,

  f.country_geo_target_id,
  ct.geo_name                      AS country_name,

  f.device,
  f.ad_network_type,

  f.impressions,
  f.clicks,
  f.interactions,
  f.conversions,
  f.conversions_value,
  f.spend,

  ${metrics.cpm("f.spend", "f.impressions")}        AS cpm,
  ${metrics.ctr("f.clicks", "f.impressions")}       AS ctr,
  ${metrics.cpc("f.spend", "f.clicks")}             AS cpc,
  ${metrics.cpa("f.spend", "f.conversions")}        AS cpa,
  ${metrics.roas("f.conversions_value", "f.spend")} AS roas
FROM ${ref("fct_gads_province_daily")} f
LEFT JOIN ${ref("dim_gads_geo")}      t  USING (geo_target_id)
LEFT JOIN ${ref("dim_gads_geo")}      ct ON ct.geo_target_id = f.country_geo_target_id
LEFT JOIN ${ref("dim_gads_campaign")} c  ON c.campaign_id    = f.campaign_id
LEFT JOIN ${ref("dim_gads_ad_group")} g  ON g.adgroup_id     = f.adgroup_id
