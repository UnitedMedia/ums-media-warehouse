config {
  type: "view",
  schema: constants.SCHEMAS.gads_reporting,
  name: "v_search_terms",
  tags: ["gads", "reporting"],
  description: "What people actually typed into Google, what it cost, and whether anybody has decided about it yet. The classic search report: find terms worth adding as keywords, and terms worth negating.",
  columns: {
    search_term: "The real query. NOT a keyword — a single broad keyword can match thousands of these.",
    search_term_status: "NONE means nobody has added or negated it. Those rows are the work list.",
    needs_decision: "TRUE where status is NONE and the term actually spent money. Sort by spend desc and you have this week's search-term review.",
    spend: "AD GROUP spend. Performance Max has no search terms, so this never totals to Google Ads spend.",
    absolute_top_impression_rate: "NON-ADDITIVE stored rate. Set Looker aggregation to MAX. Meaningful at this row, not averaged across rows.",
    cpa: "NULL where there were no conversions, never zero — SAFE_DIVIDE with NULLIF."
  }
}

-- The rate metrics below are computed AT THIS ROW GRAIN. In Looker,
-- rebuild them as calculated fields over the additive columns:
--   ctr = SUM(clicks)/SUM(impressions), cpc = SUM(spend)/SUM(clicks)
-- The average of ratios is not the ratio of sums. See CATALOG.md.

SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  f.account_id,
  c.account_name,
  c.currency,
  f.campaign_id,
  c.campaign_name,
  c.advertising_channel_type,
  f.adgroup_id,
  g.adgroup_name,

  f.search_term,
  f.search_term_match_type,
  f.search_term_status,
  (f.search_term_status = 'NONE' AND f.spend > 0) AS needs_decision,

  f.impressions,
  f.clicks,
  f.conversions,
  f.view_through_conversions,
  f.spend,

  ${metrics.cpm("f.spend", "f.impressions")}        AS cpm,
  ${metrics.ctr("f.clicks", "f.impressions")}       AS ctr,
  ${metrics.cpc("f.spend", "f.clicks")}             AS cpc,
  ${metrics.cpa("f.spend", "f.conversions")}        AS cpa,
  SAFE_DIVIDE(f.conversions, NULLIF(f.clicks, 0))  AS conversion_rate,

  f.src_absolute_top_impression_rate               AS absolute_top_impression_rate,
  f.src_top_impression_rate                        AS top_impression_rate
FROM ${ref("fct_gads_search_term_daily")} f
LEFT JOIN ${ref("dim_gads_campaign")}  c ON c.campaign_id = f.campaign_id
LEFT JOIN ${ref("dim_gads_ad_group")}  g ON g.adgroup_id  = f.adgroup_id
