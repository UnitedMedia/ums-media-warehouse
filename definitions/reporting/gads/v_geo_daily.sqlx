config {
  type: "view",
  schema: constants.SCHEMAS.gads_reporting,
  name: "v_geo_daily",
  tags: ["gads", "reporting"],
  description: "Google Ads performance by location, with resolved place names. ALWAYS FILTER TO ONE location_type — the two values are two readings of the same click, and summing them double counts.",
  columns: {
    location_type: "**Filter this on every chart, and DEFAULT TO LOCATION_OF_PRESENCE.** The two are not symmetric. Measured 2026-10-12 from 2026-09-01: presence 5,189,208.84 across 88 places, interest 372,461.32 across 50 — interest is 6.7% of presence, not a mirror of it. LOCATION_OF_PRESENCE is where the user physically was and covers all delivery. AREA_OF_INTEREST only exists where the query named a place (hotels Paris, dentist Cluj); most searches name none. Summing both overstates by about 7%.",
    geo_name: "Resolved through dim_gads_geo. Reads geo_<id> where Google's reference list has no entry.",
    canonical_name: "Full path, e.g. 'Cluj-Napoca,Cluj,Romania'. Use it when a bare name is ambiguous.",
    geo_target_type: "Country, Region, City, Postal Code, Airport. Filter on it to pick a resolution rather than mixing cities with countries on one chart.",
    spend: "AD GROUP spend. Performance Max has no ad groups, so this never totals to Google Ads money."
  }
}

-- Rate metrics below are row-grain. In Looker rebuild them as calculated
-- fields over the additive columns -- see CATALOG.md.
--
-- USE LOCATION_OF_PRESENCE unless someone specifically asks "which places were
-- people searching ABOUT". Interest is a question about intent, presence is a
-- question about audience, and only presence covers all the spend.

SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  f.account_id,
  c.account_name,
  c.currency,
  f.campaign_id,
  c.campaign_name,
  c.advertising_channel_type,
  f.adgroup_id,
  g.adgroup_name,

  f.location_type,
  f.geo_target_id,
  t.geo_name,
  t.canonical_name,
  t.country_code,
  t.geo_target_type,
  t.is_name_missing,

  f.device,
  f.ad_network_type,

  f.impressions,
  f.clicks,
  f.interactions,
  f.conversions,
  f.conversions_value,
  f.spend,

  ${metrics.cpm("f.spend", "f.impressions")}        AS cpm,
  ${metrics.ctr("f.clicks", "f.impressions")}       AS ctr,
  ${metrics.cpc("f.spend", "f.clicks")}             AS cpc,
  ${metrics.cpa("f.spend", "f.conversions")}        AS cpa,
  ${metrics.roas("f.conversions_value", "f.spend")} AS roas
FROM ${ref("fct_gads_geo_daily")} f
LEFT JOIN ${ref("dim_gads_geo")}      t USING (geo_target_id)
LEFT JOIN ${ref("dim_gads_campaign")} c ON c.campaign_id = f.campaign_id
LEFT JOIN ${ref("dim_gads_ad_group")} g ON g.adgroup_id  = f.adgroup_id
