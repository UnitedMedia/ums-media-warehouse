config {
  type: "view",
  schema: constants.SCHEMAS.gads_reporting,
  name: "v_video_daily",
  tags: ["gads", "reporting"],
  description: "Google Ads video and YouTube ads only, by ad and day. Lets you compare formats — bumper against in-stream against responsive — on cost per view. It is NOT the funnel: for quartiles and TrueView views use v_video_funnel_daily, which has them at campaign x network grain. The YouTube Earned metrics are still not synced anywhere.",
  columns: {
    ad_type: "TrueView in-stream (14,864), responsive (7,007), bumper (2,491), Demand Gen video responsive (1,841), non-skippable in-stream (1,764), plain video (1,668), in-feed (67), YouTube audio (6). Measured 2026-09-30: 29,708 video ads across eight formats.",
    video_views: "The only video metric available AT AD LEVEL. Quartile rates and video_trueview_views arrived 2026-10-02 in google_ads.youtube_ads, but only at campaign x day x network — see v_video_funnel_daily. Earned Views, Likes, Shares, Subscribers, Playlist Additions and video title are still not synced at any grain.",
    cost_per_view: "spend / video_views. The number that actually separates one video format from another.",
    view_rate: "video_views / impressions. Bumper and non-skippable will read near 1.0 by construction; skippable formats will not. Compare within a format, not across.",
    spend: "AD level, so Performance Max is absent — but PMax has no video ads anyway, so for this view the blind spot does not bite."
  }
}

SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  f.account_id,
  c.account_name,
  c.currency,
  f.campaign_id,
  c.campaign_name,
  c.advertising_channel_type,
  f.adgroup_id,
  g.adgroup_name,
  f.ad_id,
  a.ad_name,
  a.ad_type,
  a.ad_format_group,
  a.ad_status,
  a.ad_strength,
  a.is_not_serving,
  a.final_urls,

  f.impressions,
  f.clicks,
  f.interactions,
  f.video_views,
  f.conversions,
  f.conversions_value,
  f.spend,

  ${metrics.cpm("f.spend", "f.impressions")}            AS cpm,
  ${metrics.ctr("f.clicks", "f.impressions")}           AS ctr,
  ${metrics.cpc("f.spend", "f.clicks")}                 AS cpc,
  ${metrics.viewRate("f.video_views", "f.impressions")} AS view_rate,
  ${metrics.cpa("f.spend", "f.video_views")}            AS cost_per_view,
  ${metrics.cpa("f.spend", "f.conversions")}            AS cpa,
  ${metrics.roas("f.conversions_value", "f.spend")}     AS roas
FROM ${ref("fct_gads_ad_daily")} f
JOIN ${ref("dim_gads_ad")} a
  ON a.adgroup_id = f.adgroup_id AND a.ad_id = f.ad_id
LEFT JOIN ${ref("dim_gads_ad_group")} g ON g.adgroup_id = f.adgroup_id
LEFT JOIN ${ref("dim_gads_campaign")} c ON c.campaign_id = f.campaign_id
WHERE a.is_video_ad
