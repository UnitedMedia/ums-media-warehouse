config {
  type: "view",
  schema: constants.SCHEMAS.cm360_reporting,
  name: "v_hourly",
  tags: ["cm360", "reporting"],
  description: "CM360 with the hour dimension. Its own chart and its own Looker Studio data source — do not blend it with v_daily, which is the same spend at a coarser grain."
}

SELECT
  f.date,
  f.hour,
  f.advertiser_id,
  adv.advertiser_name,
  f.campaign_id,
  c.campaign_name,
  f.site_id,
  p.site_name,
  p.channel_group,
  f.placement_id,
  f.ad_id,
  f.creative_id,
  f.impressions,
  f.clicks,
  f.viewable_impressions,
  f.video_views,
  f.media_cost,
  ${metrics.ctr("f.clicks", "f.impressions")}                        AS click_rate,
  ${metrics.cpm("f.media_cost", "f.impressions")}                    AS effective_cpm,
  ${metrics.viewableRate("f.viewable_impressions", "f.impressions")} AS viewable_rate
FROM ${ref("fct_cm360_placement_hourly")} f
LEFT JOIN ${ref("dim_cm360_advertiser")} adv USING (advertiser_id)
LEFT JOIN ${ref("dim_cm360_campaign")}   c   USING (campaign_id)
LEFT JOIN ${ref("dim_cm360_placement")}  p   USING (placement_id)
WHERE ${constants.allPartitions("f")}   -- fct_cm360_placement_hourly requires a partition filter
