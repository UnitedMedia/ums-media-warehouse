config {
  type: "view",
  schema: constants.SCHEMAS.cm360_reporting,
  name: "v_hourly",
  tags: ["cm360", "reporting"],
  description: "CM360 with the hour dimension. Its own chart and its own Looker Studio data source — do not blend it with v_daily, which is the same spend at a coarser grain.",
  columns: {
    clicks: "HOUR-LEVEL CLICKS, WHICH DO NOT MATCH THE CM360 INTERFACE — 143,202 for October against a real 425,356, about a third. CM360 cannot attribute a click below campaign level and returns zero for most rows at this grain. Use them to find WHEN clicks happen relative to each other; never total them. **For any real click figure use cm360_reporting.v_campaign_daily.**",
    click_rate: "Computed from the hour-level clicks above, so it reads about two thirds low. Not comparable with the CTR in v_campaign_daily, which matches the interface."
  }
}

SELECT
  f.date,
  f.hour,
  f.advertiser_id,
  c.advertiser_name,
  f.campaign_id,
  c.campaign_name,
  f.site_id,
  p.site_name,
  p.channel_group,
  f.placement_id,
  f.ad_id,
  f.creative_id,
  f.impressions,
  f.clicks,
  f.viewable_impressions,
  f.video_views,
  f.media_cost,
  ${metrics.ctr("f.clicks", "f.impressions")}                        AS click_rate,
  ${metrics.cpm("f.media_cost", "f.impressions")}                    AS effective_cpm,
  ${metrics.viewableRate("f.viewable_impressions", "f.impressions")} AS viewable_rate
FROM ${ref("fct_cm360_placement_hourly")} f
LEFT JOIN ${ref("dim_cm360_campaign")}   c   USING (campaign_id)
LEFT JOIN ${ref("dim_cm360_placement")}  p   USING (placement_id)
WHERE ${constants.allPartitions("f")}   -- fct_cm360_placement_hourly requires a partition filter
