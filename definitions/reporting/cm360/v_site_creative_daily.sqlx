config {
  type: "view",
  schema: constants.SCHEMAS.cm360_reporting,
  name: "v_site_creative_daily",
  tags: ["cm360", "reporting"],
  description: "CM360 by site and creative, for ranking sites and creatives against each other. NOT the source of a CM360 click total — that is v_campaign_daily, from the campaign report. Its own Looker data source; never blend it with v_daily or v_geo_daily.",
  columns: {
    clicks_site_level: "NOT THE OFFICIAL CM360 CLICK FIGURE. That is v_campaign_daily, read from the campaign report. This column is named at length so the two cannot be confused in a field picker. It is good for ranking sites and creatives against each other — measured 2026-11-03..09 it totalled 140,779 against the campaign report's 140,790 — but a number quoted to anyone outside comes from the campaign report, not from here.",
    ctr_site_level: "Computed ONLY on rows that served impressions. A click-tracking row has no impression to divide by, so its CTR is NULL rather than infinite. Same warning as clicks_site_level: a rate for comparing sites, not a rate to quote.",
    cpc_serving_fee_site_level: "Serving fee per click, at this grain. Two reasons it is not a CPC anyone should quote: the cost is the ad-serving fee rather than media, and the clicks are the site-level ones.",
    is_click_tracking_only: "TRUE for a tracking tag: clicks, no impressions. Filter these OUT of a rate chart and leave them IN a click total. 41.5% of all clicks are here, the bulk of it search click tracking.",
    media_cost: "AD-SERVING FEE, not media spend. CPM of about 1 RON. Never chart it beside DV360, Meta or Google spend."
  }
}

-- WHICH SITE, WHICH CREATIVE -- AND THE CLICKS HOLD UP AT THIS GRAIN.
-- Every other CM360 detail view in this project loses clicks to the
-- dimension count: v_daily keeps 40.6% of what the interface shows, because
-- CM360 drops a click it cannot match on placement, ad, country and city all
-- at once. This view asks for three dimensions and keeps 99.99%.
--
-- So a creative comparison made here is defensible against the platform, and
-- the same comparison made in v_daily is not.
--
-- THE CLICK COLUMNS ARE STILL NOT THE OFFICIAL FIGURE, AND ARE NAMED SO.
-- CM360 clicks quoted to anyone come from the campaign report, through
-- v_campaign_daily -- one report, one number, whatever grain the question
-- arrived at. That rule predates this view and this view does not change it.
--
-- Hence clicks_site_level, ctr_site_level, cpc_serving_fee_site_level. They
-- sit one entry away from v_campaign_daily's `clicks` in a Looker field list,
-- and a short name there would be picked by accident within the week.
--
-- What they are for: ranking sites and creatives against each other, which
-- the campaign report cannot do because it has neither column. What they are
-- not for: a total, a scorecard, or a figure in a client deck.
--
-- A SECOND CAMPAIGN-LEVEL EXTRACTION IS COMING, with two months of history
-- where cm360_reach holds 43 days. When it lands it becomes the baseline for
-- assert_cm360_site_creative_reconciliation, which today compares against
-- cm360_reach. Nothing else here moves.
--
-- WHAT THIS VIEW DOES NOT HAVE: country, city, placement, ad. Those are in
-- v_geo_daily and v_daily, with their clicks. Pick the view by the question,
-- and never put two of them in one chart -- they are the same delivery at
-- different cuts, so a total across them counts it twice.
--
-- READ is_click_tracking_only BEFORE BUILDING A RATE. Of 1,148,317 clicks in
-- the source, 476,367 arrive on rows with zero impressions, and they belong
-- in the total -- the campaign report counts them too. The single largest is
-- "DART Search : Google", where the impression happened on Google and CM360
-- only ever recorded the click.
--
-- COVERAGE STARTS 2026-09-11.

SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  c.advertiser_id,
  c.advertiser_name,
  f.campaign_id,
  COALESCE(c.campaign_name, f.campaign_name) AS campaign_name,
  f.site_id,
  f.site_name,
  p.channel_group,
  f.creative_id,
  f.creative_name,

  f.impressions,
  f.clicks                                                        AS clicks_site_level,
  f.media_cost,
  f.is_click_tracking_only,

  IF(f.impressions > 0, ${metrics.ctr("f.clicks", "f.impressions")}, NULL)       AS ctr_site_level,
  IF(f.impressions > 0, ${metrics.cpm("f.media_cost", "f.impressions")}, NULL)   AS cpm_serving_fee,
  ${metrics.cpc("f.media_cost", "f.clicks")}                        AS cpc_serving_fee_site_level,

  SAFE_DIVIDE(f.impressions, SUM(f.impressions) OVER (PARTITION BY f.date, f.campaign_id))
    AS share_of_campaign_impressions,
  SAFE_DIVIDE(f.clicks, SUM(f.clicks) OVER (PARTITION BY f.date, f.campaign_id))
    AS share_of_campaign_clicks_site_level
FROM ${ref("fct_cm360_site_creative_daily")} f
LEFT JOIN ${ref("dim_cm360_campaign")} c ON f.campaign_id = c.campaign_id
LEFT JOIN (
  SELECT CAST(site_id AS STRING) AS site_id, ANY_VALUE(channel_group) AS channel_group
  FROM ${ref("dim_cm360_placement")}
  WHERE site_id IS NOT NULL
  GROUP BY 1
) p ON f.site_id = p.site_id
WHERE ${constants.allPartitions("f")}
