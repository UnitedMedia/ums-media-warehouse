config {
  type: "view",
  schema: constants.SCHEMAS.reporting,
  name: "v_data_gaps",
  tags: ["monitoring", "reporting", "docs"],
  description: "Every known gap in the warehouse, sized. These are things to fix in a seed or upstream in an extractor, NOT pipeline failures — an empty seed on day one is expected, so none of this belongs in an assertion that turns the workflow red. Review it, work the list down.",
  columns: {
    gap_type: "What kind of gap. Stable string — safe to filter a dashboard on.",
    gap_key: "The specific offender, where there is one: a site_id, an action type, an advertiser name.",
    rows_affected: "Scale of the gap in rows. Compare against the channel's total before deciding it matters.",
    spend_affected: "Money sitting behind the gap, in the channel's own currency. This is the number that decides priority."
  }
}

WITH gaps AS (

  -- DV360: line items with no booked flight dates
  SELECT
    '${constants.CHANNEL.dv360}'         AS channel,
    'dv360_missing_flight_dates'         AS gap_type,
    CAST(NULL AS STRING)                 AS gap_key,
    'No row in seed_line_item_flight. Reporting falls back to first/last active date, which is delivery, not the booking.' AS detail,
    COUNT(*)                             AS rows_affected,
    CAST(SUM(lifetime_spend) AS FLOAT64) AS spend_affected
  FROM ${ref("dim_dv360_line_item")}
  WHERE flight_start_date IS NULL

  UNION ALL

  -- CM360: sites with no name in seed_site
  SELECT
    '${constants.CHANNEL.cm360}',
    'cm360_unmapped_site',
    p.site_id,
    'Neither cm360_united nor seed_site supplied a site name, so the dashboard shows site_<id>. Since 2026-10-12 the source carries site_name directly, so this should be rare — seed_site is now only needed for channel_group and is_premium.',
    COUNT(*),
    CAST(SUM(f.media_cost) AS FLOAT64)
  FROM ${ref("fct_cm360_placement_daily")} f
  JOIN ${ref("dim_cm360_placement")} p USING (placement_id)
  WHERE p.is_site_unmapped
  GROUP BY p.site_id

  UNION ALL


  -- CM360: campaigns the hourly report never delivered. Without an hourly
  -- row there is no placement, site or creative detail and no media cost
  -- for that campaign-day — only the impression and conversion totals.
  SELECT
    '${constants.CHANNEL.cm360}',
    'cm360_campaign_missing_from_hourly',
    s.campaign_id,
    'Present in the standard campaign report but absent from the hourly report, so it has no placement, site or creative breakdown and no media cost.',
    COUNT(*),
    CAST(NULL AS FLOAT64)
  FROM ${ref("fct_cm360_campaign_daily")} s
  LEFT JOIN (
    SELECT DISTINCT date, campaign_id FROM ${ref("fct_cm360_placement_daily")}
  ) h USING (date, campaign_id)
  WHERE h.campaign_id IS NULL
  GROUP BY s.campaign_id

  UNION ALL

  -- Meta: action types that fell through every mapping rule
  SELECT
    '${constants.CHANNEL.meta}',
    'meta_unmapped_action_type',
    raw_action_type,
    'No row in seed_action_type and no matching custom conversion. It still reports, under its raw Meta name. Add it to includes/meta_actions.js.',
    COUNT(*),
    CAST(NULL AS FLOAT64)
  FROM ${ref("fct_meta_ad_action_daily")}
  WHERE ${constants.allPartitions()}
    AND metric_group = 'unmapped'
  GROUP BY raw_action_type

  UNION ALL

  -- Meta: facts whose ad was deleted before Weld synced the entity
  SELECT
    '${constants.CHANNEL.meta}',
    'meta_orphan_ad',
    CAST(NULL AS STRING),
    'Ads that spent money but have no row in dim_meta_ad, so they carry no campaign or creative labels.',
    COUNT(DISTINCT f.ad_id),
    CAST(SUM(f.spend) AS FLOAT64)
  FROM ${ref("fct_meta_ad_daily")} f
  LEFT JOIN ${ref("dim_meta_ad")} d USING (ad_id)
  WHERE ${constants.allPartitions("f")}
    AND d.ad_id IS NULL

  UNION ALL

  -- Meta: breakdown spend that cannot be attributed to an ad
  SELECT
    '${constants.CHANNEL.meta}',
    'meta_breakdown_without_ad_id',
    breakdown_type,
    'Weld does not sync ad_id for this breakdown, so these rows cannot be joined to dim_meta_ad. This is the number to show whoever configures Weld.',
    COUNTIF(ad_id IS NULL),
    CAST(SUM(IF(ad_id IS NULL, spend, 0)) AS FLOAT64)
  FROM ${ref("fct_meta_breakdown_daily")}
  WHERE ${constants.allPartitions()}
  GROUP BY breakdown_type


  UNION ALL

  -- Google Ads: the video funnel exists, but its quartile denominator does not.
  -- The rates are correct per row and cannot be aggregated: solving for the
  -- denominator that makes all four quartiles whole gives a video-impressions
  -- figure that is not in the feed (e.g. 561 where impressions is 571).
  -- Tested 2026-10-02 across every channel type: impressions works as the
  -- denominator for 230 of 7,971 VIDEO rows, the coincidence rate.
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_video_quartile_no_denominator',
    CAST(NULL AS STRING),
    'Weld does not sync video impressions, so quartile rates cannot be rolled up past campaign x day x network and no quartile COUNT can be derived. Ask for the denominator, or for these seven columns to be added to campaign_stats so youtube_ads can be dropped.',
    COUNT(*),
    CAST(NULL AS FLOAT64)
  FROM ${ref("fct_gads_campaign_video_daily")}

  UNION ALL

  -- Google Ads: the two pulls that carry the same money restate it apart.
  -- Measured 2026-10-05 over the lookback window: 35 campaign-days of
  -- 28,015 (0.125%), worst 1.06, total 7.59. Was an assertion for one run;
  -- it failed on good data, so it lives here instead. Only act on it if the
  -- numbers grow by an order of magnitude.
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_youtube_ads_spend_drift',
    CAST(NULL AS STRING),
    'youtube_ads and campaign_stats carry identical money from two pulls synced minutes apart, and Google restates cost for weeks. Expected to be non-zero and tiny. No spend is staged from youtube_ads, so this cannot reach any reported figure.',
    COUNT(*),
    CAST(SUM(abs_diff) AS FLOAT64)
  FROM (
    SELECT ABS(IFNULL(y.cost_micros, 0) - IFNULL(c.cost_micros, 0)) / 1000000 AS abs_diff
    FROM (
      SELECT DATE(date) AS date, CAST(campaign_id AS STRING) AS campaign_id,
             SUM(cost_micros) AS cost_micros
      FROM ${ref({ schema: constants.DATASETS.gads, name: "youtube_ads" })}
      WHERE _weld_deleted_at IS NULL
        AND DATE(date) >= DATE_SUB(CURRENT_DATE(), INTERVAL ${constants.WELD_LOOKBACK_DAYS} DAY)
      GROUP BY 1, 2
    ) y
    FULL JOIN (
      SELECT DATE(date) AS date, CAST(campaign_id AS STRING) AS campaign_id,
             SUM(cost_micros) AS cost_micros
      FROM ${ref({ schema: constants.DATASETS.gads, name: "campaign_stats" })}
      WHERE _weld_deleted_at IS NULL
        AND DATE(date) >= DATE_SUB(CURRENT_DATE(), INTERVAL ${constants.WELD_LOOKBACK_DAYS} DAY)
      GROUP BY 1, 2
    ) c
    USING (date, campaign_id)
    WHERE ABS(IFNULL(y.cost_micros, 0) - IFNULL(c.cost_micros, 0)) > 10000
  )

  UNION ALL

  -- Google Ads: search terms nobody has added or negated. Not a pipeline
  -- gap -- a work list. Every row is money spent on a query no one has
  -- decided about.
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_search_term_undecided',
    CAST(NULL AS STRING),
    'Search terms with status NONE that spent money: nobody has added them as a keyword or negated them. Sort gads_reporting.v_search_terms by spend with needs_decision = TRUE and work down.',
    COUNT(*),
    CAST(SUM(spend) AS FLOAT64)
  FROM ${ref("fct_gads_search_term_daily")}
  WHERE search_term_status = 'NONE'
    AND spend > 0

  UNION ALL

  -- Google Ads: locations that delivered but have no name in geo_target
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_geo_without_name',
    geo_target_id,
    'Delivered spend against a location id that google_ads.geo_target does not list, so it reads as geo_<id>. Usually a retired location code.',
    1,
    CAST(lifetime_spend AS FLOAT64)
  FROM ${ref("dim_gads_geo")}
  WHERE is_name_missing

  UNION ALL

  -- Google Ads: youtube_ads duplicates rows since 2026-10-14. Its sync was
  -- switched to incremental and now INSERTS instead of replacing. Staging
  -- de-duplicates on _weld_synced, so nothing reported is affected -- this
  -- row exists so the upstream defect stays visible while Weld fixes it.
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_youtube_ads_duplicate_rows',
    CAST(NULL AS STRING),
    'google_ads.youtube_ads holds more rows than distinct date+campaign+network keys. The load inserts rather than replaces. Clean on 2026-10-02 (142,678 rows, 142,678 keys). stg_gads_campaign_network_daily de-duplicates, so no reported number is wrong — but never query the raw table without a QUALIFY.',
    (SELECT COUNT(*) - COUNT(DISTINCT FORMAT('%t|%t|%t', DATE(date), CAST(campaign_id AS STRING), ad_network_type))
     FROM ${ref({ schema: constants.DATASETS.gads, name: "youtube_ads" })}
     WHERE _weld_deleted_at IS NULL),
    CAST(NULL AS FLOAT64)

  UNION ALL

  -- CM360: the Keboola extraction duplicates rows since 2026-10-15. Staging
  -- removes them with SELECT DISTINCT -- every duplicate pair is identical in
  -- every column -- so nothing reported is affected. This row keeps the
  -- upstream defect visible while Keboola fixes the load.
  SELECT
    '${constants.CHANNEL.cm360}',
    'cm360_duplicate_rows',
    CAST(NULL AS STRING),
    'keboola_cm360 tables hold more rows than distinct grain keys: cm360_hourly 268,317 rows against 187,970 keys on 2026-10-15, cm360_floodlightsv2 1.3% duplicated, down from 40% in the v1 table it replaced on 2026-10-17. The load inserts rather than replaces. Staging de-duplicates, so no reported number is wrong — but never query the raw tables without SELECT DISTINCT.',
    (SELECT COUNT(*) - COUNT(DISTINCT FORMAT('%t|%t|%t|%t|%t', date, hour, placementId, adId, creativeId))
     FROM ${ref({ schema: constants.DATASETS.cm360, name: "cm360_hourly" })}),
    CAST(NULL AS FLOAT64)

  UNION ALL

  -- CM360: rows that share the hourly grain key but carry DIFFERENT metrics.
  -- Not duplicates -- SELECT DISTINCT already removed the byte-identical
  -- ones. These are the extraction splitting one hour across two rows with
  -- different numbers. fct_cm360_placement_hourly SUMs them, which is the
  -- only sensible reading, so nothing reported is wrong.
  SELECT
    '${constants.CHANNEL.cm360}',
    'cm360_hourly_split_rows',
    CAST(NULL AS STRING),
    'Rows sharing date + hour + placement + ad + creative with different impressions or media_cost. The mart sums them. Part of the extraction malfunction that began 2026-10-06 — see cm360_unreliable_since.',
    COUNT(*),
    CAST(NULL AS FLOAT64)
  FROM (
    SELECT 1 AS x
    FROM ${ref("stg_cm360_hourly")}
    GROUP BY date, hour, placement_id, ad_id, creative_id
    HAVING COUNT(*) > 1
  )

  UNION ALL

  -- CM360: the hourly and daily reports stopped agreeing on 2026-10-06.
  -- Measured over 07-11 October: hourly 19,780,323 impressions against
  -- united 21,237,014, a 6.9% gap. Over 01-05 October the same two reports
  -- agreed to 144 impressions in 21.4 million.
  --
  -- This was an assertion until 2026-10-16. It is real and it is Keboola's
  -- to fix; no change here makes it green, and a permanently red gate is one
  -- people stop reading.
  SELECT
    '${constants.CHANNEL.cm360}',
    'cm360_unreliable_since_2026_10_06',
    CAST(NULL AS STRING),
    'The CM360 extraction began duplicating rows, splitting hours and disagreeing with itself on 2026-10-06. cm360_hourly and cm360_united differ by ~7% for the same days where they previously agreed to 0.0007%. TREAT ALL CM360 NUMBERS FROM 2026-10-06 AS UNRELIABLE until Keboola fixes the job. Everything before that date is sound.',
    (SELECT COUNT(DISTINCT date) FROM ${ref("stg_cm360_hourly")}
     WHERE date >= DATE '2026-10-06'),
    CAST(NULL AS FLOAT64)

  UNION ALL

  -- TikTok: spend the ad-level report cannot attribute to a named ad
  SELECT
    '${constants.CHANNEL.tiktok}',
    'tiktok_spend_without_ad',
    CAST(NULL AS STRING),
    'Campaign-level spend with no matching ad-level rows. TikTok cannot attribute every impression to a named ad, so ad-level charts understate by this much.',
    1,
    CAST((SELECT SUM(spend) FROM ${ref("fct_tiktok_campaign_daily")})
       - (SELECT SUM(spend) FROM ${ref("fct_tiktok_ad_daily")}) AS FLOAT64)

  UNION ALL

  -- TikTok: breakdown rows TikTok publishes only at campaign level
  SELECT
    '${constants.CHANNEL.tiktok}',
    'tiktok_breakdown_without_ad_id',
    breakdown_type,
    'TikTok publishes this breakdown at campaign level only, so the rows carry no ad_id and cannot be joined to dim_tiktok_ad.',
    COUNTIF(ad_id IS NULL),
    CAST(SUM(IF(ad_id IS NULL, spend, 0)) AS FLOAT64)
  FROM ${ref("fct_tiktok_breakdown_daily")}
  GROUP BY breakdown_type

  UNION ALL

  -- TikTok: campaigns that spent money but have no entity record
  SELECT
    '${constants.CHANNEL.tiktok}',
    'tiktok_campaign_missing_from_entity',
    campaign_id,
    'Delivered spend but absent from tiktok_ads.campaign, so it has no name, objective or budget. Name falls back to campaign_<id>; advertiser and currency are resolved from the fact instead, so money is never unlabelled.',
    COUNT(*),
    CAST(NULL AS FLOAT64)
  FROM ${ref("dim_tiktok_campaign")}
  WHERE is_name_missing
  GROUP BY campaign_id

  UNION ALL

  -- Google Ads: campaigns that spent money but have no entity record
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_campaign_missing_from_entity',
    campaign_id,
    'Delivered spend but absent from google_ads.campaign, so channel type, status and booked flight dates are unknown. The name still resolves because campaign_stats carries it.',
    COUNT(*),
    CAST(NULL AS FLOAT64)
  FROM ${ref("dim_gads_campaign")}
  WHERE is_entity_missing
  GROUP BY campaign_id

  UNION ALL

  -- Google Ads: test accounts carrying spend. Not real money, and
  -- excluded from core — but if this returns rows, someone is looking at
  -- them in gads_reporting without realising.
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_test_account_with_spend',
    d.account_id,
    'Flagged as a Google Ads test account but carries spend. Excluded from core.fct_ad_performance_daily; still visible in gads_reporting behind is_test_account.',
    COUNT(*),
    CAST(SUM(f.spend) AS FLOAT64)
  FROM ${ref("fct_gads_campaign_daily")} f
  JOIN ${ref("dim_gads_campaign")} d USING (campaign_id)
  WHERE d.is_test_account
  GROUP BY d.account_id

  UNION ALL

  -- Google Ads: Performance Max spend with no ad group or ad detail
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_pmax_no_lower_detail',
    CAST(NULL AS STRING),
    'Performance Max reports at campaign level only. This spend has no ad group, ad, keyword or asset breakdown anywhere in the feed — Weld syncs no asset or asset_group table, so PMax cannot be opened up at all.',
    COUNT(DISTINCT f.campaign_id),
    CAST(SUM(f.spend) AS FLOAT64)
  FROM ${ref("fct_gads_campaign_daily")} f
  JOIN ${ref("dim_gads_campaign")} d USING (campaign_id)
  WHERE d.advertising_channel_type = 'PERFORMANCE_MAX'

  UNION ALL

  -- Google Ads: campaigns on a shared budget, where campaign-level
  -- pacing cannot be computed
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_shared_budget',
    budget_id,
    'This budget is shared across several campaigns, so budget_amount belongs to the group. Campaign-level budget utilisation in v_pacing is meaningless for these — group by budget_id instead.',
    COUNT(*),
    CAST(NULL AS FLOAT64)
  FROM ${ref("dim_gads_campaign")}
  WHERE is_shared_budget
  GROUP BY budget_id

  UNION ALL

  -- Google Ads: spend an account reports that its campaigns do not
  -- account for.
  --
  -- This was an assertion and is deliberately no longer one. Google
  -- restates cost for weeks, Weld re-syncs a rolling 31-day window, and
  -- account_stats and campaign_stats are synced minutes apart — so the
  -- two will always disagree slightly and no threshold separated that
  -- noise from a real gap without either firing constantly or being so
  -- loose it would miss anything worth catching. It reports here instead.
  --
  -- What to look for: one account with a persistent, material share is
  -- worth chasing. A long tail of tiny percentages is restatement lag.
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_account_spend_above_campaigns',
    a.account_id,
    'This account reports more spend than the sum of its campaigns. Small percentages are Google restating cost between two separately-synced tables. A persistent material share means campaign-level Google figures are low.',
    1,
    CAST(a.spend - COALESCE(c.spend, 0) AS FLOAT64)
  FROM (
    SELECT account_id, SUM(spend) AS spend
    FROM ${ref("fct_gads_account_daily")}
    WHERE date < CURRENT_DATE()
    GROUP BY 1
  ) a
  LEFT JOIN (
    SELECT account_id, SUM(spend) AS spend
    FROM ${ref("fct_gads_campaign_daily")}
    WHERE date < CURRENT_DATE()
    GROUP BY 1
  ) c USING (account_id)
  WHERE a.spend - COALESCE(c.spend, 0) > 1

  UNION ALL

  -- Google Ads: audience segments with no name anywhere in the feed
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_audience_without_name',
    CAST(NULL AS STRING),
    'audience_stats carries only a criterion id, so audience segments report as numbers. Names live in user_list, user_interest and topic, which Weld syncs but this project does not declare.',
    COUNT(DISTINCT audience_criterion_id),
    CAST(SUM(spend) AS FLOAT64)
  FROM ${ref("fct_gads_audience_daily")}

  UNION ALL

  -- Google Ads: ads that are not serving
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_ad_not_serving',
    policy_approval_status,
    'Ads that are DISAPPROVED or not ENABLED. They cannot deliver, and this is usually the explanation for an ad group underspending its budget.',
    COUNT(*),
    CAST(NULL AS FLOAT64)
  FROM ${ref("dim_gads_ad")}
  WHERE is_not_serving
  GROUP BY policy_approval_status

  UNION ALL

  -- Google Ads: keywords Google rates 4 or below
  SELECT
    '${constants.CHANNEL.gads}',
    'gads_low_quality_keyword',
    quality_landing_page,
    'Keywords with a Quality Score of 4 or below, grouped by their landing page component. Low quality raises what you pay per click. Where the landing page component is BELOW_AVERAGE the fix is outside the media team.',
    COUNT(*),
    CAST(NULL AS FLOAT64)
  FROM ${ref("dim_gads_keyword")}
  WHERE quality_score IS NOT NULL AND quality_score <= 4
  GROUP BY quality_landing_page

  UNION ALL

  -- Core: spend that cannot be converted to euros
  SELECT
    channel,
    'core_spend_without_fx_rate',
    COALESCE(currency, '(no currency)'),
    'No exchange rate for this currency and month, so spend_eur is NULL and this money is absent from every euro total. Add a row to core_seeds.seed_fx_rate_manual, or settle what CM360 media_cost is.',
    COUNT(*),
    CAST(SUM(spend) AS FLOAT64)
  FROM ${ref("fct_ad_performance_daily")}
  WHERE NOT is_fx_converted
  GROUP BY channel, currency

  UNION ALL

  -- Teads: on 2026-10-29 the extraction had appended rather than
  -- replaced -- teads_uv_daily held 4,880 rows for 2,972 distinct grain
  -- keys, 39% inflation across 3 extractions, the same defect
  -- cm360_duplicate_rows and gads_youtube_duplicate_rows describe.
  -- On 2026-10-30 both tables were exactly clean, one extraction each.
  --
  -- So these two rows are usually ZERO, and the view filters
  -- rows_affected > 0, which means they are invisible until it happens
  -- again. That is the point: staging de-duplicates either way, so the
  -- only symptom of a relapse would be this row appearing.
  SELECT
    '${constants.CHANNEL.teads}',
    'teads_duplicate_rows',
    'teads_uv_daily',
    'Rows beyond the distinct grain count. Zero on 2026-10-30; 1,908 on 2026-10-29. If this is non-zero the extraction has gone back to inserting instead of replacing. Staging de-duplicates on extracted_at either way, so nothing reported is wrong — but never query the raw table without de-duplicating.',
    (SELECT COUNT(*) - COUNT(DISTINCT FORMAT('%t|%t|%t|%t|%t|%t|%t',
       day, seat_id, advertiser_id, campaign_id, line_item_id, creative_id, line_item_billable_event))
     FROM ${ref({ schema: constants.DATASETS.teads, name: "teads_uv_daily" })}),
    CAST(NULL AS FLOAT64)

  UNION ALL

  SELECT
    '${constants.CHANNEL.teads}',
    'teads_duplicate_rows',
    'teads_daily',
    'Same check as teads_uv_daily. Clean on both 2026-10-29 and 2026-10-30. Non-zero means the load started inserting instead of replacing.',
    (SELECT COUNT(*) - COUNT(DISTINCT FORMAT('%t|%t|%t|%t|%t|%t',
       day, seat_id, advertiser_id, campaign_id, line_item_id, creative_id))
     FROM ${ref({ schema: constants.DATASETS.teads, name: "teads_daily" })}),
    CAST(NULL AS FLOAT64)

  UNION ALL

  -- Teads: budget_spent diverging from budget_delivered.
  --
  -- WHICH COLUMN IS SPEND IS SETTLED. Day by day against MASTER_TABLE,
  -- budget_delivered matches EXACTLY, to the cent, on all 15 days from
  -- 2026-10-01 to 10-15; budget_spent matches on 8 and runs 6-10% low
  -- over 10-09 to 10-15. Delivered is the billed figure.
  --
  -- This row is therefore no longer a decision to make. It sizes a real
  -- divergence between two real measurements, so that if spent ever
  -- starts tracking delivered -- or stops -- somebody sees it.
  SELECT
    '${constants.CHANNEL.teads}',
    'teads_budget_columns_disagree',
    CAST(NULL AS STRING),
    'budget_delivered <> budget_spent. Delivered is the billed figure, confirmed against MASTER_TABLE day by day. spend_affected is how far spent sits from it — around 6-10% on the days it diverges, zero on the days it does not. Informational: nothing reported uses budget_spent.',
    COUNT(*),
    CAST(SUM(ABS(spend - budget_spent)) AS FLOAT64)
  FROM ${ref("fct_teads_creative_daily")}
  WHERE spend IS DISTINCT FROM budget_spent

  UNION ALL

  -- Core: clients with no canonical name — this is what splits one
  -- client into three in every cross-channel report
  SELECT
    channel,
    'core_unmapped_client',
    advertiser_raw_name,
    'No row in seed_client_name_map for this (channel, name), so the cross-channel report groups it under the channel spelling.',
    COUNT(*),
    CAST(SUM(spend) AS FLOAT64)
  FROM ${ref("fct_ad_performance_daily")}
  WHERE is_client_unmapped
  GROUP BY channel, advertiser_raw_name
)

SELECT *
FROM gaps
WHERE rows_affected > 0
