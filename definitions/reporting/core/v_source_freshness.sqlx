config {
  type: "view",
  schema: constants.SCHEMAS.reporting,
  name: "v_source_freshness",
  tags: ["monitoring", "reporting", "docs"],
  description: "How recent every FEED is, always visible. assert_source_freshness returns only the stale ones; this lists all of them whether healthy or not, so 'what is failing?' is one query rather than an inference from an assertion's error text.",
  columns: {
    feed: "The individual sync, not the channel. A connector can drop one table while the rest keep flowing, which is why both this view and the assertion are per feed.",
    latest_data_date: "The most recent date present in that feed's mart. NOT when the extraction last ran — a pipe can run daily and deliver nothing new.",
    days_stale: "Days between latest_data_date and today.",
    is_stale: "TRUE once days_stale passes freshnessThresholdDays. These rows are exactly what assert_source_freshness returns."
  }
}

-- ONE ROW PER FEED, matching assert_source_freshness branch for branch.
--
-- This view used to carry one row per CHANNEL, reading only the backbone
-- fact, while the assertion already watched 15 separate feeds. So when
-- the assertion went red on a non-backbone feed the view could not say
-- which one — it did not contain the failing row at all. That is the
-- opposite of what a monitoring view is for, and it is how Teads /
-- unique viewers went three days without being locatable here.
--
-- THE RULE: adding a branch to assert_source_freshness means adding the
-- same branch here. They are the same list; one gates the workflow and
-- one explains it. If they drift again the explanation stops working.
--
-- Three Meta marts carry requirePartitionFilter, so their branches need
-- constants.allPartitions() or BigQuery refuses the query outright.

WITH latest AS (
  -- DV360 ----------------------------------------------------------------
  SELECT '${constants.CHANNEL.dv360}' AS channel, 'line item daily' AS feed,
         MAX(date) AS latest_data_date
  FROM ${ref("fct_dv360_daily")}

  UNION ALL
  SELECT '${constants.CHANNEL.dv360}', 'breakdowns', MAX(date)
  FROM ${ref("fct_dv360_breakdown_daily")}

  -- CM360 ----------------------------------------------------------------
  UNION ALL
  SELECT '${constants.CHANNEL.cm360}', 'placement daily', MAX(date)
  FROM ${ref("fct_cm360_placement_daily")}

  UNION ALL
  SELECT '${constants.CHANNEL.cm360}', 'campaign daily', MAX(date)
  FROM ${ref("fct_cm360_campaign_daily")}

  -- Meta -----------------------------------------------------------------
  UNION ALL
  SELECT '${constants.CHANNEL.meta}', 'ad daily', MAX(date)
  FROM ${ref("fct_meta_ad_daily")}
  WHERE ${constants.allPartitions()}

  UNION ALL
  SELECT '${constants.CHANNEL.meta}', 'ad actions', MAX(date)
  FROM ${ref("fct_meta_ad_action_daily")}
  WHERE ${constants.allPartitions()}

  UNION ALL
  SELECT '${constants.CHANNEL.meta}', 'breakdowns', MAX(date)
  FROM ${ref("fct_meta_breakdown_daily")}
  WHERE ${constants.allPartitions()}

  UNION ALL
  SELECT '${constants.CHANNEL.meta}', 'demographics', MAX(date)
  FROM ${ref("fct_meta_demographic_daily")}

  UNION ALL
  SELECT '${constants.CHANNEL.meta}', 'age x gender', MAX(date)
  FROM ${ref("fct_meta_age_gender_daily")}

  -- TikTok ---------------------------------------------------------------
  UNION ALL
  SELECT '${constants.CHANNEL.tiktok}', 'campaign daily', MAX(date)
  FROM ${ref("fct_tiktok_campaign_daily")}

  UNION ALL
  SELECT '${constants.CHANNEL.tiktok}', 'ad daily', MAX(date)
  FROM ${ref("fct_tiktok_ad_daily")}

  UNION ALL
  SELECT '${constants.CHANNEL.tiktok}', 'breakdowns', MAX(date)
  FROM ${ref("fct_tiktok_breakdown_daily")}

  -- Google Ads -----------------------------------------------------------
  UNION ALL
  SELECT '${constants.CHANNEL.gads}', 'campaign daily', MAX(date)
  FROM ${ref("fct_gads_campaign_daily")}

  UNION ALL
  SELECT '${constants.CHANNEL.gads}', 'ad daily', MAX(date)
  FROM ${ref("fct_gads_ad_daily")}

  UNION ALL
  SELECT '${constants.CHANNEL.gads}', 'audience daily', MAX(date)
  FROM ${ref("fct_gads_audience_daily")}

  -- Teads ----------------------------------------------------------------
  UNION ALL
  SELECT '${constants.CHANNEL.teads}', 'creative daily', MAX(date)
  FROM ${ref("fct_teads_creative_daily")}

  UNION ALL
  SELECT '${constants.CHANNEL.teads}', 'unique viewers', MAX(date)
  FROM ${ref("fct_teads_reach_daily")}
)
SELECT
  channel,
  feed,
  latest_data_date,
  DATE_DIFF(CURRENT_DATE(), latest_data_date, DAY) AS days_stale,
  DATE_DIFF(CURRENT_DATE(), latest_data_date, DAY)
    > ${dataform.projectConfig.vars.freshnessThresholdDays}        AS is_stale,
  ${dataform.projectConfig.vars.freshnessThresholdDays}            AS threshold_days,
  CURRENT_DATE()                                                   AS as_of
FROM latest
ORDER BY days_stale DESC, channel, feed
