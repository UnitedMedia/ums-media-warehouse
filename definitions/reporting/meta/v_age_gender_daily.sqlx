config {
  type: "view",
  schema: constants.SCHEMAS.meta_reporting,
  name: "v_age_gender_daily",
  tags: ["meta", "reporting"],
  description: "Meta by age and gender WITH CAMPAIGN NAME, daily. The one demographic view that can be labelled with a campaign — v_demographics_daily cannot, because its source has no campaign key.",
  columns: {
    share_of_campaign_spend: "This bucket's share of the campaign's spend that day, 0-1. The distribution question, and the main reason to use this view.",
    ctr_all_clicks: "Uses Meta's ALL-INTERACTION clicks. It reads HIGHER than the CTR in v_ad_daily, which uses link clicks. Do not put the two on one chart — use ctr_link_clicks for that.",
    ctr_link_clicks: "Link-click CTR. THIS is the one comparable with v_ad_daily and with the cross-channel view. Available since 2026-11-09.",
    spend_eur: "Converted at the month's rate from core.dim_fx_rate. NULL where no rate exists — check is_fx_converted before totalling across accounts.",
    reach: "DELIBERATELY NOT HERE, and it is NOT unavailable — see v_age_gender_reach_daily. It is kept out of this view because it is non-additive and everything else here is additive, which is the combination that produces a believable wrong number."
  }
}

-- DAILY since 2026-10-12, which changed two things for the better:
--   * it rolls up to calendar months, which the old weekly grain could not
--     (a week such as 28 Sep - 4 Oct is half September, half October)
--   * it can carry spend_eur, because dim_fx_rate is keyed on month and a
--     daily row belongs to exactly one
--
-- Rate metrics are computed AT THIS ROW GRAIN. In Looker rebuild them as
-- calculated fields over the additive columns -- see CATALOG.md.
--
-- TWO THINGS ARRIVED 2026-11-09, both of which were in the source all
-- along and documented here as absent:
--   * link_clicks, so this view finally has a CTR comparable with
--     v_ad_daily instead of only the inflated all-interaction one
--   * reach, which went to v_age_gender_reach_daily rather than here
--
-- The figures in this view also CHANGED that day, upward. Staging was
-- dropping source rows that differed only by asset id: 694,133
-- impressions and 3,929.75 spend in October alone. See the note in
-- stg_meta_age_gender.

SELECT
  f.date,
  DATE_TRUNC(f.date, WEEK(MONDAY)) AS week,
  DATE_TRUNC(f.date, MONTH)        AS month,

  f.account_id,
  acc.account_name,
  acc.account_currency        AS currency,

  f.campaign_id,
  c.campaign_name,
  c.objective,
  c.campaign_status,

  f.age,
  f.gender,

  f.spend,
  SAFE_DIVIDE(f.spend, fx.rate_to_eur)                  AS spend_eur,
  fx.rate_to_eur                                        AS fx_rate_to_eur,
  (fx.rate_to_eur IS NOT NULL)                          AS is_fx_converted,

  f.impressions,
  f.clicks_all,
  f.link_clicks,
  f.ad_format_assets,

  SAFE_DIVIDE(f.spend, SUM(f.spend) OVER w)             AS share_of_campaign_spend,
  SAFE_DIVIDE(f.impressions, SUM(f.impressions) OVER w) AS share_of_campaign_impressions,

  ${metrics.cpm("f.spend", "f.impressions")}            AS cpm,
  ${metrics.ctr("f.clicks_all", "f.impressions")}       AS ctr_all_clicks,
  ${metrics.ctr("f.link_clicks", "f.impressions")}      AS ctr_link_clicks,
  ${metrics.cpc("f.spend", "f.clicks_all")}             AS cpc_all_clicks,
  ${metrics.cpc("f.spend", "f.link_clicks")}            AS cpc_link_clicks
FROM ${ref("fct_meta_age_gender_daily")} f
LEFT JOIN ${ref("stg_meta_campaign")} c   ON c.campaign_id = f.campaign_id
LEFT JOIN ${ref("stg_meta_account")}  acc ON acc.account_id = f.account_id
LEFT JOIN ${ref("dim_fx_rate")} fx
  ON  fx.month    = DATE_TRUNC(f.date, MONTH)
  AND fx.currency = acc.account_currency
WINDOW w AS (PARTITION BY f.date, f.campaign_id)
