config {
  type: "assertion",
  tags: ["meta", "monitoring"],
  description: "facebook_ads_weld.age_gender must stay one row per date + campaign + age + gender. A duplicate would put two different spend figures on the same bucket with no way to tell which is right."
}

-- HISTORY, because the shape of this check changed on 2026-10-12.
--
-- This source used to publish ROLLING 7-DAY WINDOWS: no date column, every
-- row spanning date_start..date_stop = 6 days, and a new window opening
-- every day. Each day therefore appeared in seven rows and SUM(spend)
-- returned 29.2M against a true ~4M. Staging kept only Monday starts and
-- this assertion watched for the window length changing.
--
-- Weld switched the report to time_increment: 1 and the columns changed
-- with it -- date_start and date_stop are gone, replaced by a single date.
-- Verified: 600,800 rows, 105 days from 2026-06-30, spend 4,456,568.88.
--
-- So the window check is retired. If Weld ever reverts, date_start and
-- date_stop reappear and stg_meta_age_gender fails on a missing column,
-- which is louder than any assertion. What remains worth watching is
-- duplicates, which the staging QUALIFY would hide if it ever drifted.

SELECT
  'duplicate date + campaign + age + gender' AS problem,
  CONCAT(CAST(date AS STRING), ' ', campaign_id, ' ',
         IFNULL(age, 'null'), ' ', IFNULL(gender, 'null')) AS detail,
  COUNT(*)                                   AS rows_affected
FROM ${ref("fct_meta_age_gender_daily")}
GROUP BY 1, 2
HAVING COUNT(*) > 1
