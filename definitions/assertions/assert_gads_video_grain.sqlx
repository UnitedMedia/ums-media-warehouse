config {
  type: "assertion",
  tags: ["gads", "monitoring"],
  description: "stg_gads_campaign_network_daily must hold one row per date x campaign x ad_network_type. It de-duplicates a source that does not, so this is a check that the de-duplication still holds — not a check on the source."
}

-- WHAT THIS WATCHES, AND WHY IT MOVED TWICE.
--
-- 1. It watched staging. Clean, until the source broke.
-- 2. 2026-10-14: the source began inserting instead of replacing -- 83 keys
--    arrived twice from consecutive runs, identical cost_micros. Staging
--    gained a QUALIFY, and this assertion was pointed at the RAW table so
--    the sync problem stayed visible.
-- 3. Same day: moved back. Pointing it at the source made it permanently red
--    over something that CANNOT affect any reported number -- staging
--    de-duplicates and fct_gads_campaign_video_daily is clean. A blocking
--    check on a harmless upstream defect is how people learn to ignore red.
--
-- The duplication is now reported in reporting.v_data_gaps as
-- gads_youtube_ads_duplicate_rows, sized, where it is visible without
-- failing the workflow. That is the same treatment
-- gads_account_spend_above_campaigns and gads_youtube_ads_spend_drift got,
-- and the README's rule: a check that cannot go green on data nobody here
-- can fix is the wrong check.
--
-- What remains worth blocking on: the de-duplication failing. If the source
-- ever duplicates on a key this QUALIFY does not cover, rows reach the mart
-- twice and spend doubles. That is this assertion.

SELECT
  'duplicate date + campaign + network AFTER de-duplication' AS problem,
  CONCAT(CAST(date AS STRING), ' ', campaign_id, ' ', ad_network_type) AS detail,
  COUNT(*)                                                   AS rows_affected
FROM ${ref("stg_gads_campaign_network_daily")}
GROUP BY 1, 2
HAVING COUNT(*) > 1
