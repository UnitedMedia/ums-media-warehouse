config {
  type: "assertion",
  tags: ["gads", "monitoring"],
  description: "google_ads.youtube_ads must stay one row per date x campaign x ad_network_type. A duplicate here would put two different quartile rates on the same campaign-day-network and there would be no way to tell which is right."
}

-- THIS DELIBERATELY DOES NOT COMPARE SPEND against campaign_stats.
--
-- The first version did, with a one-cent tolerance, and it failed on good
-- data: 35 disagreeing campaign-days out of 28,015 (0.125%), worst 1.06,
-- total 7.59 across the whole lookback window. Both tables come from Google,
-- are synced minutes apart, and Google restates cost for weeks — so that
-- noise is permanent and self-healing, and no threshold separates it from a
-- real problem without eventually being wrong in one direction or the other.
--
-- That is the same trap assert_gads_account_reconciliation fell into, and
-- the README records the rule: if a check cannot be made to go green on
-- good data, it is the wrong check. The comparison now reports in
-- reporting.v_data_gaps as gads_youtube_ads_spend_drift, where it is
-- visible without turning the workflow red.
--
-- It costs nothing to be strict about the grain, though: fct_gads_campaign_video_daily
-- carries no spend, so duplicates here cannot corrupt money — only the funnel.

SELECT
  'duplicate date + campaign + network'  AS problem,
  CONCAT(CAST(date AS STRING), ' ', campaign_id, ' ', ad_network_type) AS detail,
  COUNT(*)                               AS rows_affected
FROM ${ref("stg_gads_campaign_network_daily")}
GROUP BY 1, 2
HAVING COUNT(*) > 1
