config {
  type: "assertion",
  tags: ["gads", "monitoring"],
  description: "google_ads.youtube_ads must hold one row per date x campaign x ad_network_type. It does not as of 2026-10-14 — the sync inserts instead of replacing. Staging de-duplicates so nothing downstream breaks; this stays red until Weld fixes the load."
}

-- WATCHES THE RAW TABLE, NOT STAGING.
--
-- It used to watch stg_gads_campaign_network_daily. On 2026-10-14 that view
-- gained a QUALIFY to survive the source duplicating rows — which would have
-- made this assertion permanently green and permanently useless. Pointing it
-- at the source keeps the signal where the problem is.
--
-- What happened: the sync was switched to incremental and began INSERTING
-- rather than REPLACING. 83 keys arrived twice, from the 13 and 14 October
-- runs, with identical cost_micros. On 2026-10-02 the same table was clean:
-- 142,678 rows, 142,678 keys.
--
-- Clean on 2026-10-02, broken by 2026-10-14. That is what an eleven-day-old
-- grain check is for.

SELECT
  'duplicate date + campaign + network'  AS problem,
  CONCAT(CAST(DATE(date) AS STRING), ' ',
         CAST(campaign_id AS STRING), ' ', ad_network_type) AS detail,
  COUNT(*)                               AS rows_affected
FROM ${ref({ schema: constants.DATASETS.gads, name: "youtube_ads" })}
WHERE _weld_deleted_at IS NULL
GROUP BY 1, 2
HAVING COUNT(*) > 1
