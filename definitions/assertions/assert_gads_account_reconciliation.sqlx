config {
  type: "assertion",
  tags: ["gads", "monitoring"],
  description: "Each Google Ads account's campaigns must account for its spend. Compared per ACCOUNT across all complete days, not per account-day: the question is whether the campaign layer is missing money, and that is a property of an account over time."
}

-- Why per account and not per account-day.
--
-- Measured 2026-09-24: the per-day version left exactly one row — one
-- account, one day, 0.27%, with the CAMPAIGN side 2.97 higher than the
-- account side. Google restates cost for weeks (invalid-click credits),
-- Weld re-syncs a rolling 31-day window, and account_stats and
-- campaign_stats are synced minutes apart. A single day will therefore
-- disagree slightly and it means nothing.
--
-- What would matter is an account whose campaigns systematically fail to
-- account for its spend. Summing the whole window per account tests that
-- directly and cannot be tripped by one day's restatement lag.
--
-- Today is excluded on both sides: the two tables sync at different times
-- of the night, so a partial day is always inconsistent between them.

WITH by_campaign AS (
  SELECT account_id, SUM(spend) AS spend
  FROM ${ref("fct_gads_campaign_daily")}
  WHERE date < CURRENT_DATE()
  GROUP BY 1
),
by_account AS (
  SELECT account_id, SUM(spend) AS spend
  FROM ${ref("fct_gads_account_daily")}
  WHERE date < CURRENT_DATE()
  GROUP BY 1
),
joined AS (
  SELECT
    COALESCE(a.account_id, c.account_id) AS account_id,
    COALESCE(a.spend, 0)                 AS account_spend,
    COALESCE(c.spend, 0)                 AS campaign_rollup_spend
  FROM by_account a
  FULL JOIN by_campaign c USING (account_id)
)
SELECT
  account_id,
  ROUND(account_spend, 2)                                AS account_spend,
  ROUND(campaign_rollup_spend, 2)                        AS campaign_rollup_spend,
  ROUND(account_spend - campaign_rollup_spend, 2)        AS spend_diff,
  SAFE_DIVIDE(ABS(account_spend - campaign_rollup_spend),
              NULLIF(account_spend, 0))                  AS relative_diff
FROM joined
WHERE ABS(account_spend - campaign_rollup_spend) > 1
  AND SAFE_DIVIDE(ABS(account_spend - campaign_rollup_spend),
                  NULLIF(account_spend, 0))
      > ${dataform.projectConfig.vars.gadsAccountReconciliationTolerance}
