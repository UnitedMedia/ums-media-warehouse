config {
  type: "assertion",
  tags: ["meta", "monitoring"],
  description: "Meta spend must survive staging and the mart unchanged. Rows here mean the pipeline dropped, duplicated or altered money between the raw Weld table and fct_meta_ad_daily."
}

-- The raw side de-duplicates independently, re-implementing the rule
-- rather than reading stg_meta_ad_insight — a test that calls the thing
-- it is testing proves nothing.
--
-- Why de-duplicate here at all: Weld re-syncs a day and leaves every
-- version in ad_roas_insight, which is exactly why staging carries a
-- QUALIFY. Summing raw as-is would count a re-synced day twice and this
-- assertion would fire on healthy data. If you want to know HOW MUCH
-- re-syncing is happening, that is the sibling query in the README's
-- verification section, not a pipeline failure.

WITH raw AS (
  SELECT
    DATE(date)             AS date,
    CAST(spend AS NUMERIC) AS spend
  FROM ${ref({ schema: constants.DATASETS.meta, name: "ad_roas_insight" })}
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY DATE(date), CAST(ad_id AS STRING)
    ORDER BY _weld_synced DESC
  ) = 1
),
raw_daily AS (
  SELECT date, SUM(spend) AS spend
  FROM raw
  GROUP BY 1
),
mart AS (
  SELECT date, SUM(spend) AS spend
  FROM ${ref("fct_meta_ad_daily")}
  WHERE ${constants.allPartitions()}
  GROUP BY 1
)
SELECT
  COALESCE(r.date, m.date)                    AS date,
  r.spend                                     AS raw_spend,
  m.spend                                     AS mart_spend,
  COALESCE(r.spend, 0) - COALESCE(m.spend, 0) AS diff
FROM raw_daily r
FULL JOIN mart m USING (date)
WHERE ABS(COALESCE(r.spend, 0) - COALESCE(m.spend, 0))
      > ${dataform.projectConfig.vars.metaSpendTolerance}
