config {
  type: "assertion",
  tags: ["gads", "monitoring"],
  description: "Google Ads staging deliberately does NOT de-duplicate: verified 2026-09-23, account and campaign are one row per id and campaign_stats is one row per date x campaign x device x network. This watches all three assumptions. If it fires, add a QUALIFY — and not before."
}

WITH stats_grain AS (
  SELECT
    'stg_gads_campaign_daily' AS model,
    CONCAT(CAST(date AS STRING), ' | ', campaign_id, ' | ',
           COALESCE(device, 'null'), ' | ', COALESCE(ad_network_type, 'null')) AS key_value,
    COUNT(*) AS rows_at_grain
  FROM ${ref("stg_gads_campaign_daily")}
  GROUP BY 1, 2
  HAVING COUNT(*) > 1
),
campaign_grain AS (
  SELECT 'stg_gads_campaign', campaign_id, COUNT(*)
  FROM ${ref("stg_gads_campaign")}
  GROUP BY 1, 2
  HAVING COUNT(*) > 1
),
account_grain AS (
  SELECT 'stg_gads_account', account_id, COUNT(*)
  FROM ${ref("stg_gads_account")}
  GROUP BY 1, 2
  HAVING COUNT(*) > 1
)
SELECT * FROM stats_grain
UNION ALL SELECT * FROM campaign_grain
UNION ALL SELECT * FROM account_grain
