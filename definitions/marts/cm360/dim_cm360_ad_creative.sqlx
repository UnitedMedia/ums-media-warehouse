config {
  type: "table",
  schema: constants.SCHEMAS.cm360_marts,
  name: "dim_cm360_ad_creative",
  tags: ["cm360", "marts"],
  description: "One row per ad x creative pair, with its landing page. A landing page can change over a creative's life, so the most recently seen URL wins.",
  bigquery: {
    clusterBy: ["ad_id", "creative_id", "placement_id"]
  },
  assertions: {
    uniqueKey: ["ad_id", "creative_id"]
  }
}

SELECT
  ad_id,
  creative_id,
  placement_id,
  campaign_id,
  landing_page_url,
  first_active_date,
  last_active_date
FROM (
  SELECT
    ad_id,
    creative_id,
    placement_id,
    campaign_id,
    landing_page_url,
    MIN(date) OVER (PARTITION BY ad_id, creative_id) AS first_active_date,
    MAX(date) OVER (PARTITION BY ad_id, creative_id) AS last_active_date,
    ROW_NUMBER() OVER (PARTITION BY ad_id, creative_id ORDER BY date DESC) AS rn
  FROM ${ref("stg_cm360_hourly")}
  WHERE ad_id IS NOT NULL
)
WHERE rn = 1
