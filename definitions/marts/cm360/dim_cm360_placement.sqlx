config {
  type: "table",
  schema: constants.SCHEMAS.cm360_marts,
  name: "dim_cm360_placement",
  tags: ["cm360", "marts"],
  description: "One row per CM360 placement, with the site name resolved through seed_site.",
  bigquery: {
    clusterBy: ["placement_id", "campaign_id", "site_id"]
  },
  assertions: {
    uniqueKey: ["placement_id"],
    nonNull: ["placement_id"]
  },
  columns: {
    first_active_date: "DERIVED from delivery, NOT the CM360 Placement Start Date field — that field is not in the report. A placement booked but not yet delivering has no row here at all. Substituting this for a real flight date is wrong for pacing.",
    is_site_unmapped: "TRUE where seed_site has no row for this site_id. assert_cm360_site_mapping watches the spend behind these."
  }
}

SELECT
  h.placement_id,
  h.site_id,
  COALESCE(s.site_name, CONCAT('site_', h.site_id))     AS site_name,
  s.channel_group,
  s.is_premium,
  h.campaign_id,
  c.campaign_name,
  h.advertiser_id,
  c.advertiser_name,
  MIN(h.date)                                           AS first_active_date,
  MAX(h.date)                                           AS last_active_date,
  DATE_DIFF(MAX(h.date), MIN(h.date), DAY) + 1          AS active_day_span,
  (s.site_name IS NULL)                                 AS is_site_unmapped
FROM ${ref("stg_cm360_hourly")} h
LEFT JOIN ${ref("seed_site")} s USING (site_id)
LEFT JOIN ${ref("dim_cm360_campaign")} c USING (campaign_id)
WHERE h.placement_id IS NOT NULL
GROUP BY 1,2,3,4,5,6,7,8,9,13
