config {
  type: "incremental",
  schema: constants.SCHEMAS.cm360_marts,
  name: "fct_cm360_campaign_daily",
  tags: ["cm360", "marts"],
  description: "CM360 standard report at date + campaign. The only source of total_conversions. Its impressions and clicks are a CHECKSUM against the hourly rollup, not a second source to add — hence the _check suffix.",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["campaign_id"]
  },
  assertions: {
    uniqueKey: ["date", "campaign_id"],
    nonNull: ["date"]
  }
}


-- INCREMENTAL, APPEND-ONLY. The Keboola extract holds ONE DAY at a time
-- (confirmed 2026-10-05: fct_dv360_lineitem_daily_v5 had a single date,
-- cm360_hourly likewise). A full rebuild therefore wrote a one-day mart and
-- threw the rest away, which is exactly what had happened by 5 Oct.
--
-- The predicate loads any date NOT ALREADY in the table, rather than
-- `date > MAX(date)`. That distinction matters: if Keboola ever backfills
-- June to September, a MAX(date) predicate would skip all of it, because
-- every backfilled date is older than what is already here.
--
-- Append-only rather than a uniqueKey MERGE, deliberately. Half the grain
-- columns here are nullable (country, app_url, creative_asset ...), and
-- BigQuery MERGE joins with `=`, which never matches NULL to NULL — so a
-- null-keyed row would be re-inserted on every single run, forever.
-- Loading each date exactly once cannot duplicate anything.
--
-- THE TRADE-OFF: a date already loaded is never reloaded, so an upstream
-- RESTATEMENT of an existing day is ignored. DV360 revises conversions for
-- several days after delivery. When a restatement or backfill matters, run
-- this table once with FULL REFRESH and it rebuilds from whatever the
-- source currently holds.


-- WAS stg_cm360_campaign_daily -> fct_cm360_campaign_daily. Folded into one
-- object on 2026-10-13: the staging view was not a source wrapper, it was a
-- join of two other staging views, so it only added a name to the graph.
--
-- Delivery from cm360_united, conversions from cm360_floodlightsv2 (named
-- cm360_floodlights until Keboola renamed it on 2026-10-17). Its old
-- source, cm360_standard_table, was dropped in the move to keboola_cm360.
-- Conversions are summed across Floodlight activities because that is what
-- the old column meant; fct_cm360_floodlight_daily has the detail.

WITH delivery AS (
  SELECT
    date,
    campaign_id,
    ANY_VALUE(profile_id)      AS profile_id,
    ANY_VALUE(profile_name)    AS profile_name,
    ANY_VALUE(campaign_name)   AS campaign_name,
    ANY_VALUE(advertiser_id)   AS advertiser_id,
    ANY_VALUE(advertiser_name) AS advertiser_name,
    SUM(impressions)           AS impressions,
    SUM(clicks)                AS clicks
  FROM ${ref("stg_cm360_united")}
  WHERE campaign_id IS NOT NULL
  GROUP BY date, campaign_id
),
conversions AS (
  SELECT
    date,
    campaign_id,
    SUM(total_conversions)         AS total_conversions,
    SUM(total_conversions_revenue) AS total_conversions_revenue
  FROM ${ref("stg_cm360_floodlight")}
  WHERE campaign_id IS NOT NULL
  GROUP BY date, campaign_id
)
SELECT
  d.date,
  d.campaign_id,
  d.advertiser_id,
  SUM(d.impressions)              AS impressions_check,
  SUM(d.clicks)                   AS clicks_check,
  ANY_VALUE(c.total_conversions)  AS total_conversions
FROM delivery d
LEFT JOIN conversions c USING (date, campaign_id)
WHERE d.date IS NOT NULL
-- THE INCREMENTAL PREDICATE. It was lost on 2026-10-13 when the staging view
-- was folded in here and the body rewritten: the model stayed
-- type: "incremental" but had neither this predicate nor a top-level
-- uniqueKey, so every run appended the WHOLE source again. A full refresh
-- cleaned it and the next ordinary run doubled it, which is why the uniqueKey
-- assertion failed immediately after a successful refresh.
--
-- core.fct_ad_performance_daily reads this mart, so its own uniqueKey failed
-- too -- one bug, two red assertions.
${when(incremental(),
  `AND d.date NOT IN (SELECT DISTINCT date FROM ${self()}
                      WHERE ${constants.allPartitions()})`)}
GROUP BY 1, 2, 3
