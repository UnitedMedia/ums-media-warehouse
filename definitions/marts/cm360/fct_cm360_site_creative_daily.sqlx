config {
  type: "table",
  schema: constants.SCHEMAS.cm360_marts,
  name: "fct_cm360_site_creative_daily",
  tags: ["cm360", "marts"],
  description: "CM360 at date x campaign x site x creative. THE CLICK-ACCURATE CM360 DETAIL TABLE — 99.99% of the campaign figure, where fct_cm360_placement_daily keeps 40.6%. Use this for site and creative questions; use the placement fact only for country and city.",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["campaign_id", "site_id", "creative_id"],
    requirePartitionFilter: true
  },
  // NO assertions BLOCK, AND THAT IS NOT AN OVERSIGHT. Dataform generates
  // uniqueKey / nonNull / rowConditions assertions WITHOUT a date filter,
  // and this table carries requirePartitionFilter, so BigQuery refuses to
  // run them. Grain is guarded by assert_cm360_site_creative_grain, which
  // puts the filter in. Same arrangement as fct_meta_ad_daily.
  columns: {
    clicks: "Reconciled to cm360_reach, the campaign-level figure that matches the CM360 interface, at 99.99% — which is why this table is worth having. It is still NOT the figure anyone quotes: CM360 clicks come from the campaign report through v_campaign_daily, one report and one number. The reporting view exposes this as clicks_site_level for exactly that reason. Use it to rank sites and creatives against each other, which the campaign report cannot do.",
    is_click_tracking_only: "TRUE where there are clicks and no impressions — a tracking tag, not a served placement. 41.5% of all clicks. Exclude these rows from a CTR chart; never exclude them from a click total.",
    serving_fee: "WHAT CM360 CHARGED TO SERVE THE AD, in account currency. Renamed from media_cost on 2026-11-11 because media_cost_eur now sits beside it and two columns of money with almost the same name is how this goes wrong. Measured 2026-11-03..09: 41,410.60 against 42,746,274 impressions, a CPM of 0.97. Never put it next to another channel's spend.",
    media_cost_eur: "WHAT THE MEDIA COST, in EUR, from FINAL_TABLES.CM360 — the booked rate in the media plan times the delivery. NULL for programmatic: a BidManager campaign was bought in DV360 and its cost lives there, so 24 of 142 campaigns have none and that is correct. Validated against the AOS dashboard to the cent."
  }
}

-- WHY A SECOND DETAIL FACT FOR THE SAME CHANNEL.
--
-- fct_cm360_placement_daily is built on cm360_united, which carries six
-- dimensions and keeps 40.6% of the clicks. That is not a bug in the model:
-- CM360 drops a click it cannot match on every requested dimension, so the
-- loss is created by the report's own shape.
--
-- This table asks for three dimensions and keeps 99.99%. The two are not
-- redundant and must not be unioned -- they are the same delivery cut two
-- ways, and the finer one also inflates impressions by 42% against the
-- campaign total.
--
--   site or creative question            -> this table
--   country or city question             -> fct_cm360_placement_daily
--   campaign total, or anything quoted
--   against the CM360 interface          -> fct_cm360_reach_daily
--
-- THE THIRD LINE IS NOT SOFTENED BY THE SECOND. This table's clicks match
-- the campaign report at 99.99%, and the campaign report is still where a
-- quoted click comes from. One report, one number, whatever grain the
-- question arrived at. The reporting view names the column clicks_site_level
-- so the two cannot be confused in a field picker.
--
-- A SECOND CAMPAIGN-LEVEL EXTRACTION IS COMING, carrying two months where
-- cm360_reach holds 43 days. It becomes the baseline for
-- assert_cm360_site_creative_reconciliation when it lands; this table does
-- not change.
--
-- NOT INCREMENTAL. The source holds 60 days and restates them; a full
-- rebuild picks restatements up and costs little. Same rule as every other
-- CM360 mart since 2026-11-03.
--
-- NO reach HERE. CM360 publishes unique reach only at campaign level, and it
-- is in fct_cm360_reach_daily. Reach per site or per creative would not sum
-- to a campaign anyway.

-- THE COST JOIN, AND WHY IT IS SHAPED THIS WAY.
--
-- CM360 does not know what the media cost. The legacy pipeline does: it
-- multiplies the booked rate from the media plan by the delivery and writes
-- the product to FINAL_TABLES.CM360.media_cost, in EUR. That table is still
-- produced daily and is where the AOS dashboards get their figures.
--
-- JOINED ON creative_id, NOT ON NAMES. FINAL_TABLES.CM360 carries no
-- campaign_id and no site_id, so a name join was the obvious route and is
-- the worse one: measured over October it matched 60.51% of impressions
-- against 60.91% for date + creative_id + site, the difference being
-- campaigns renamed on one side and not the other.
--
-- THE COST IS SPREAD BY IMPRESSION SHARE, which is the part worth reading
-- twice. 60 of 45,669 date + creative_id + site keys belong to more than
-- one campaign on our side, while the cost table has exactly one row per
-- such key. A plain join would attach the whole cost to each of them and
-- invent money. Splitting by impressions gives each row its part and keeps
-- the total exact; where the key has one campaign, which is 99.87% of them,
-- the share is 1 and nothing happens.
--
-- THE COALESCE IS NOT DEFENSIVE PADDING, it carries 7,837.09 EUR. An
-- impression share is undefined when the key served no impressions at all,
-- and 352 keys are exactly that: click-tracking placements, which are 41.5%
-- of CM360 clicks and were booked and paid for like any other. Dividing by
-- their zero impressions returned NULL and dropped their cost -- measured
-- before the fix, 343,105.30 arrived out of 350,942.39. So when there are
-- no impressions to weight by, the cost splits evenly across the rows.
--
-- VERIFIED: 350,942.39 in FINAL_TABLES.CM360 over 2026-09-11..11-09, and
-- 350,942.39 in this table. Every euro that has a matching row arrives.
--
-- 61% OF IMPRESSIONS GET A COST, AND THAT IS THE RIGHT ANSWER. Of the
-- campaigns with none, 24 of 25 are BidManager -- programmatic, bought in
-- DV360, so there is no media plan and no booked rate. The 25th is
-- UMS_HelpNet_White Label, which looks like a plan that was never entered;
-- assert_cm360_media_cost_coverage names anything else that appears.

WITH cost AS (
  SELECT
    date,
    CAST(creative_id AS STRING) AS creative_id,
    NULLIF(TRIM(site), '')      AS site_name,
    SUM(media_cost)             AS media_cost_eur
  FROM ${ref({ schema: constants.DATASETS.final, name: "CM360" })}
  WHERE media_cost IS NOT NULL
  GROUP BY 1, 2, 3
)

SELECT
  f.date,
  f.campaign_id,
  f.site_id,
  f.creative_id,
  f.campaign_name,
  f.site_name,
  f.creative_name,
  f.impressions,
  f.clicks,
  f.media_cost AS serving_fee,

  c.media_cost_eur * COALESCE(
    SAFE_DIVIDE(f.impressions, NULLIF(SUM(f.impressions) OVER (
      PARTITION BY f.date, f.creative_id, f.site_name), 0)),
    SAFE_DIVIDE(1, COUNT(*) OVER (
      PARTITION BY f.date, f.creative_id, f.site_name))
  ) AS media_cost_eur,

  f.is_click_tracking_only
FROM ${ref("stg_cm360_basic")} f
LEFT JOIN cost c
  ON  f.date        = c.date
  AND f.creative_id = c.creative_id
  AND f.site_name   = c.site_name
