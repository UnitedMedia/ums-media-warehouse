config {
  type: "table",
  schema: constants.SCHEMAS.gads_marts,
  name: "dim_gads_ad",
  tags: ["gads", "marts"],
  description: "One row per Google Ads ad, keyed on adgroup_id + ad_id. Carries type, status, URLs, ad strength and policy approval — everything the feed gives about an ad except its creative text, which Weld does not sync at all.",
  bigquery: {
    clusterBy: ["account_id", "campaign_id", "adgroup_id", "ad_id"]
  },
  assertions: {
    uniqueKey: ["adgroup_id", "ad_id"],
    nonNull: ["ad_id", "adgroup_id"]
  },
  columns: {
    is_not_serving: "TRUE where the ad is DISAPPROVED or not ENABLED. The fastest explanation for an ad with zero delivery.",
    ad_format_group: "VIDEO / SEARCH / DISPLAY / SHOPPING / SMART / UNKNOWN, derived from the raw ad type. Grouping exists because the raw values are 15 strings and nobody filters a dashboard on VIDEO_TRUE_VIEW_IN_DISPLAY by hand.",
    is_video_ad: "TRUE for every VIDEO_* type and YOUTUBE_AUDIO. Measured 2026-09-30: 27,864 of 338,849 ads. Note this identifies the FORMAT — the video funnel metrics (quartiles, TrueView views, YouTube Earned actions) are not synced."
  }
}

-- Keyed on the PAIR. ad_id alone is not unique: the same ad copied into
-- several ad groups keeps its id, and 10,817 ids are in that position.

SELECT
  a.ad_id,
  a.adgroup_id,
  a.campaign_id,
  a.account_id,
  a.ad_name,
  a.ad_type,
  a.ad_type_raw,
  CASE
    WHEN a.ad_type_raw LIKE 'VIDEO%' OR a.ad_type_raw = 'YOUTUBE_AUDIO' THEN 'VIDEO'
    WHEN a.ad_type_raw LIKE 'SEARCH%'   THEN 'SEARCH'
    WHEN a.ad_type_raw LIKE 'DISPLAY%'  THEN 'DISPLAY'
    WHEN a.ad_type_raw LIKE 'SHOPPING%' THEN 'SHOPPING'
    WHEN a.ad_type_raw LIKE 'SMART%'    THEN 'SMART'
    ELSE 'UNKNOWN'
  END                                                    AS ad_format_group,
  (a.ad_type_raw LIKE 'VIDEO%' OR a.ad_type_raw = 'YOUTUBE_AUDIO') AS is_video_ad,
  a.ad_status,
  a.ad_strength,
  a.added_by_google_ads,
  a.device_preference,
  a.display_url,
  a.final_urls,
  a.final_mobile_urls,
  a.final_url_suffix,
  a.tracking_url_template,
  a.policy_approval_status,
  a.policy_review_status,
  (a.policy_approval_status = 'DISAPPROVED' OR a.ad_status != 'ENABLED') AS is_not_serving
FROM ${ref("stg_gads_ad")} a
