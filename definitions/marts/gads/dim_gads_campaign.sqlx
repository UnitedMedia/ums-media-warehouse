config {
  type: "table",
  schema: constants.SCHEMAS.gads_marts,
  name: "dim_gads_campaign",
  tags: ["gads", "marts"],
  description: "One row per Google Ads campaign that has delivered, with its account, currency and real booked flight dates. Driven by DELIVERY, not by the entity table — the same lesson as dim_tiktok_campaign, where building from the entity list nulled out currency for campaigns the entity sync had missed.",
  bigquery: {
    clusterBy: ["account_id", "campaign_id"]
  },
  assertions: {
    uniqueKey: ["campaign_id"],
    nonNull: ["campaign_id", "account_id"]
  },
  columns: {
    campaign_name: "From the entity table, falling back to the name carried on the fact itself. Google Ads puts campaign_name on campaign_stats, so unlike TikTok a missing entity row never costs us the name.",
    flight_start_date: "REAL booked dates from the platform, not inferred from delivery. Google Ads is the only channel here that provides them.",
    is_entity_missing: "TRUE where the campaign delivered spend but has no row in google_ads.campaign, so channel type, status and flight dates are unknown.",
    advertising_channel_type: "PERFORMANCE_MAX campaigns exist at campaign level only — they have no ad groups, and they are about a fifth of spend.",
    budget_amount: "CURRENT budget, not the budget on any past day — google_ads.campaign_budget has no date column. Check budget_period before doing arithmetic.",
    is_shared_budget: "TRUE when the budget is shared across campaigns. Its amount then belongs to the group, not this campaign, and campaign-level pacing is meaningless.",
    target_cpa: "What the campaign is bidding towards. Compare with the actual cpa in v_daily — that comparison is the point of carrying it.",
    target_impression_share_fraction: "A SETTING. Achieved impression share is NOT synced by Weld, so there is nothing to compare it against."
  }
}

WITH delivered AS (
  SELECT
    campaign_id,
    ANY_VALUE(account_id)     AS account_id,
    ANY_VALUE(campaign_name)  AS campaign_name_from_fact,
    ANY_VALUE(account_name)   AS account_name_from_fact
  FROM ${ref("stg_gads_campaign_daily")}
  WHERE campaign_id IS NOT NULL
  GROUP BY campaign_id
)
SELECT
  d.campaign_id,
  COALESCE(c.campaign_name, d.campaign_name_from_fact,
           CONCAT('campaign_', d.campaign_id))        AS campaign_name,
  (c.campaign_id IS NULL)                             AS is_entity_missing,
  c.advertising_channel_type,
  c.advertising_channel_sub_type,
  c.campaign_status,
  c.serving_status,
  c.experiment_type,
  c.flight_start_date,
  c.flight_end_date,
  c.campaign_optimization_score,
  COALESCE(c.account_id, d.account_id)                AS account_id,
  COALESCE(a.account_name, d.account_name_from_fact)  AS account_name,
  a.currency_code                                     AS currency,
  a.time_zone,
  a.account_status,
  COALESCE(a.is_manager, FALSE)                       AS is_manager,
  COALESCE(a.is_test_account, FALSE)                  AS is_test_account,

  -- budget and bidding are CURRENT STATE, joined in here so a campaign
  -- has one row carrying what it is trying to do as well as what it did
  b.budget_id,
  b.budget_name,
  b.budget_period,
  b.budget_amount,
  b.budget_total_amount,
  b.recommended_budget_amount,
  COALESCE(b.is_shared_budget, FALSE)                 AS is_shared_budget,
  b.campaigns_on_budget,
  bid.bidding_strategy_type,
  bid.bidding_strategy_system_status,
  bid.target_cpa,
  bid.target_roas,
  bid.target_impression_share_location,
  bid.target_impression_share_fraction
FROM delivered d
LEFT JOIN ${ref("stg_gads_campaign")} c ON c.campaign_id = d.campaign_id
LEFT JOIN ${ref("stg_gads_account")}  a
  ON a.account_id = COALESCE(c.account_id, d.account_id)
LEFT JOIN ${ref("stg_gads_campaign_budget")}  b   ON b.campaign_id   = d.campaign_id
LEFT JOIN ${ref("stg_gads_campaign_bidding")} bid ON bid.campaign_id = d.campaign_id
