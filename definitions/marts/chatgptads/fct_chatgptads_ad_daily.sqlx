config {
  type: "table",
  schema: constants.SCHEMAS.chatgptads_marts,
  name: "fct_chatgptads_ad_daily",
  tags: ["chatgptads", "marts"],
  description: "THE ChatGPT Ads fact. Day x ad, with the account currency attached. core.fct_ad_performance_daily rolls it up to campaign.",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["ad_account_id", "campaign_id", "ad_id"]
  },
  assertions: {
    uniqueKey: ["date", "ad_id"],
    nonNull: ["date", "ad_id", "currency"]
  },
  columns: {
    currency: "Joined from dim_chatgptads_account. Asserted non-null — spend that cannot name its own currency cannot be converted, and this fails loudly rather than silently.",
    spend: "In the account's own currency, RON or EUR. Convert through dim_fx_rate; do not add RON and EUR rows together."
  }
}

-- The currency join is the reason this fact exists at all rather than
-- the staging view being read directly: spend here is meaningless
-- without knowing which currency it is in, and the delivery feed does
-- not say.

SELECT
  f.date,
  f.ad_account_id,
  ANY_VALUE(f.ad_account_name) AS ad_account_name,
  ANY_VALUE(a.currency_code)   AS currency,
  f.campaign_id,
  ANY_VALUE(f.campaign_name)   AS campaign_name,
  ANY_VALUE(f.ad_group_id)     AS ad_group_id,
  ANY_VALUE(f.ad_group_name)   AS ad_group_name,
  f.ad_id,
  ANY_VALUE(f.ad_name)         AS ad_name,

  SUM(f.impressions) AS impressions,
  SUM(f.clicks)      AS clicks,
  SUM(f.spend)       AS spend
FROM ${ref("stg_chatgptads_ad_daily")} f
LEFT JOIN ${ref("dim_chatgptads_account")} a USING (ad_account_id)
WHERE f.date IS NOT NULL
GROUP BY f.date, f.ad_account_id, f.campaign_id, f.ad_id
