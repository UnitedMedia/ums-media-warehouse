config {
  type: "table",
  schema: constants.SCHEMAS.meta_marts,
  name: "fct_meta_ad_daily",
  tags: ["meta", "marts"],
  description: "Meta ad x day. Additive metrics only, no ratios. requirePartitionFilter is ON, so every downstream query must filter on date.",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["account_id", "campaign_id", "ad_id"],
    requirePartitionFilter: true
  },
  columns: {
    reach: "Deduplicated by Meta at ad x day. Never SUM it above this grain — roll-ups of reach are not reach."
  }
}

-- No config-level assertions on this table. Dataform generates them
-- without a date filter, and requirePartitionFilter makes BigQuery
-- reject any such query. The equivalent checks live in
-- assert_meta_ad_daily_grain, which filters explicitly.

SELECT
  date,
  account_id,
  campaign_id,
  adset_id,
  ad_id,
  currency,
  spend,
  impressions,
  clicks,
  link_clicks,
  reach
FROM ${ref("stg_meta_ad_insight")}
