config {
  type: "table",
  schema: constants.SCHEMAS.dv360_marts,
  name: "fct_dv360_reach_daily",
  tags: ["dv360", "marts"],
  dependencies: ["assert_keboola_window"],
  description: "DV360 unique reach. ISOLATED BY DESIGN: no metric from any other fact belongs in here. Unique reach is non-additive — summing it across days or line items overstates reach, and joining it to an impression fact multiplies impressions by the number of matching reach rows.",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["advertiser_id", "line_item_id"]
  },
  assertions: {
    nonNull: ["date"]
  }
}

-- Quarantining reach in its own table with no shared metrics is the
-- only structural defence against someone writing SUM(unique_reach)
-- next to SUM(impressions) and getting a number that looks plausible.


-- WAS INCREMENTAL AND APPEND-ONLY UNTIL 2026-11-03, for the same reason
-- as fct_cm360_placement_hourly and changed for the same reason. Read
-- the note in that file for the full story; the short version:
--
-- The design assumed the Keboola extract held ONE DAY at a time, which
-- it did on 2026-10-05. Under that assumption a full rebuild wrote a
-- one-day mart and threw the rest away, so append-only was correct.
--
-- The cost was that a date already loaded was never reloaded, so an
-- upstream restatement of an existing day was ignored forever.
--
-- MEASURED 2026-11-03 against stg_dv360_reach: 12 of 34 days diverged,
-- 381 unique reach in total. Small -- far smaller than the 26,900 clicks
-- the same defect cost CM360 -- but it is the same defect, and reach is
-- a number nobody can sanity-check by eye, so a quiet 381 would have
-- stayed quiet indefinitely.
--
-- The premise is gone: staging now covers 2026-09-28 to 10-31, the same
-- 34 days this table held, so a full rebuild loses nothing.
--
-- IF THE EXTRACT EVER GOES BACK TO HOLDING ONE DAY, a rebuild would
-- write a one-day mart. The dependency on assert_keboola_window above
-- prevents that: the assertion fails below a 7-day window and this
-- table is skipped rather than rebuilt from nothing.

SELECT
  date,
  partner_id,
  advertiser_id,
  line_item_id,
  SUM(unique_reach) AS unique_reach
FROM ${ref("stg_dv360_reach")}
WHERE date IS NOT NULL
GROUP BY 1,2,3,4
