config {
  type: "incremental",
  schema: constants.SCHEMAS.dv360_marts,
  name: "fct_dv360_breakdown_daily",
  tags: ["dv360", "marts"],
  description: "DV360's breakdowns in one table: geo, url, timeofday, audience, floodlight, targeting. ALWAYS filter to one breakdown_type — they are six cuts of the SAME spend and summing across them multiplies it by six.",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["breakdown_type", "advertiser_id", "line_item_id"]
  },
  assertions: {
    uniqueKey: ["date", "breakdown_type", "line_item_id", "breakdown_1", "breakdown_2"],
    nonNull: ["date", "breakdown_type"]
  },
  columns: {
    breakdown_type: "PART OF THE GRAIN, and part of the incremental load key. Six values, six complete copies of the same delivery. One per chart, never a total across them.",
    total_conversions: "floodlight and targeting only. The other breakdowns split conversions into postclick + postview."
  }
}

-- Replaces fct_dv360_geo_daily, fct_dv360_placement_daily,
-- fct_dv360_timeofday_daily and fct_dv360_audience_daily, plus a
-- floodlight fact that was never built. Four marts and a gap, into one.
--
-- Incremental, append-only, like every DV360 mart.

SELECT
  date,
  breakdown_type,
  advertiser_id,
  line_item_id,
  advertiser_currency,
  breakdown_1,
  breakdown_2,

  SUM(impressions)           AS impressions,
  SUM(clicks)                AS clicks,
  SUM(interactions)          AS interactions,
  SUM(complete_views)        AS complete_views,
  SUM(postclick_conversions) AS postclick_conversions,
  SUM(postview_conversions)  AS postview_conversions,
  SUM(total_conversions)     AS total_conversions,
  SUM(spend)                 AS spend
FROM ${ref("stg_dv360_breakdown")}
WHERE date IS NOT NULL
-- THE PREDICATE IS KEYED ON date + breakdown_type, NOT date ALONE, and the
-- difference is not theoretical. It was `date NOT IN (...)` until
-- 2026-10-22, when the sixth breakdown -- targeting -- was added and loaded
-- SEVEN days: 09-21 to 09-27, the only dates the other five had not already
-- written. Every targeting row from 09-28 onward was silently skipped,
-- because a date already in the table is a date this predicate will never
-- load again, no matter which breakdown_type is missing from it.
--
-- The table is one row per date PER TYPE, so the load key has to be both.
-- A new breakdown added tomorrow now backfills its full history on the
-- first run instead of landing with a hole exactly as wide as the table's
-- existing date range.
--
-- Concatenated rather than a tuple IN: BigQuery has no (a,b) NOT IN (...)
-- form, and NOT EXISTS against a partitioned self-reference is harder to
-- read than this.
${when(incremental(),
  `AND FORMAT('%t|%t', date, breakdown_type) NOT IN (
     SELECT DISTINCT FORMAT('%t|%t', date, breakdown_type) FROM ${self()}
     WHERE ${constants.allPartitions()})`)}
GROUP BY 1, 2, 3, 4, 5, 6, 7
