config {
  type: "table",
  schema: constants.SCHEMAS.dv360_marts,
  name: "fct_dv360_daily",
  tags: ["dv360", "marts"],
  dependencies: ["assert_keboola_window"],
  description: "DV360 backbone fact: line item x day. The source of truth for spend, and the only fact carrying invalid clicks, TrueView views, Total_Conversions and USD spend. Rebuilt in full on every run since 2026-11-18 -- see assert_keboola_window for what makes that safe.",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["advertiser_id", "campaign_id", "line_item_id"]
  },
  assertions: {
    uniqueKey: ["date", "line_item_id", "advertiser_currency"],
    nonNull: ["date", "line_item_id"]
  }
}


-- SWITCHED FROM INCREMENTAL APPEND-ONLY TO A FULL REBUILD ON 2026-11-18,
-- the same move fct_cm360_placement_hourly and fct_dv360_reach_daily made
-- on 2026-11-03, for the same reason and with the same safety net.
--
-- WHAT APPEND-ONLY DID HERE. The predicate was
-- `date NOT IN (SELECT DISTINCT date FROM self)`, so a date entered this
-- table exactly once and was never looked at again. DV360 does not finish
-- counting a day the moment it ends -- the figures climb for hours. Any day
-- this model happened to read while the source was still filling kept
-- whatever sliver was there at that instant, permanently.
--
-- IT WENT WRONG IN THE WEEK OF 2026-11-11. Measured on 2026-11-18, against
-- the source, before the repair:
--
--   11-13    131 impressions held, 2,365,616 in the source
--   11-16     19,520 held, 3,249,438 in the source
--   11-17      1,538 held, 2,659,518 in the source
--   11-11  3,494,164 held, 3,951,989 in the source
--
-- Across 11-11..11-17 the table carried 13,311,652 impressions against
-- 22,064,932, and 10,844.26 EUR against 19,850.92. DV360 reporting was
-- missing 45% of its spend for a week. Nothing caught it: the grain was
-- unique, nothing was null, and the newest date was current, so
-- assert_source_freshness was green throughout. It surfaced only because
-- one campaign was compared by hand against FINAL_TABLES.MASTER_TABLE.
--
-- A full refresh fixed it, and also repaired the 2026-10-05..10-17 window
-- that stg_dv360_lineitem notes as damaged -- those partitions had been
-- written before the QUALIFY existed and append-only could never revisit
-- them. That is the second restatement this model silently refused.
--
-- WHY A FULL REBUILD IS SAFE NOW. Append-only was written on 2026-10-05,
-- when the Keboola extract held ONE DAY at a time and a full rebuild had
-- already destroyed the history once. That premise is gone. The extractor
-- loads the last few days into Keboola STORAGE with a primary key, and
-- Storage keeps everything it has ever been given -- the writer then
-- replaces the BigQuery table with the whole of it. Measured 2026-11-18:
-- kebooladv.fct_dv360_lineitem holds 44 days, 2026-10-06 to 2026-11-18,
-- and grows by one each day rather than sliding. A rebuild can no longer
-- lose what it rebuilds from.
--
-- THE COST OF THE SWITCH, PAID ONCE. The mart had accumulated 2026-09-28
-- to 2026-10-05 -- eight days the source has never held, because Storage
-- itself starts on 10-06. The first full rebuild dropped them: 599 rows,
-- 21,297,117 impressions, 39,723.47 EUR, 45 campaigns. They are kept in
-- OTHERS.backup_dv360_daily_20260928_20261005 and come back for good only
-- if Keboola backfills that range into Storage.
--
-- assert_keboola_window IS THE GUARD, and this model depends on it so a
-- failure skips the rebuild rather than running it. If the extract ever
-- collapses back to a handful of days, the assertion turns red and this
-- table keeps yesterday's content instead of being replaced by a stub.

SELECT
  date,
  advertiser_id,
  campaign_id,
  insertion_order_id,
  line_item_id,
  advertiser_currency,
  SUM(impressions)           AS impressions,
  SUM(clicks)                AS clicks,
  SUM(invalid_clicks)        AS invalid_clicks,
  SUM(interactions)          AS interactions,
  SUM(complete_views)        AS complete_views,
  SUM(trueview_views)        AS trueview_views,
  SUM(total_conversions)     AS total_conversions,
  SUM(postclick_conversions) AS postclick_conversions,
  SUM(postview_conversions)  AS postview_conversions,
  SUM(spend)                 AS spend,
  SUM(spend_usd)             AS spend_usd
FROM ${ref("stg_dv360_lineitem")}
WHERE date IS NOT NULL
GROUP BY 1,2,3,4,5,6
