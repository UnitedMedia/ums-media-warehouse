config {
  type: "incremental",
  schema: constants.SCHEMAS.dv360_marts,
  name: "fct_dv360_audience_daily",
  tags: ["dv360", "marts"],
  description: "DV360 impressions by audience category: line item x category x day. NEVER SUM ACROSS audience_category — one impression can match several segments, so the total exceeds the line item's real impressions.",
  bigquery: {
    partitionBy: "date",
    clusterBy: ["advertiser_id", "line_item_id", "audience_category"]
  },
  assertions: {
    uniqueKey: ["date", "line_item_id", "audience_category"],
    nonNull: ["date", "line_item_id"]
  },
  columns: {
    audience_category: "PART OF THE GRAIN and non-additive. Summing across it double counts, exactly like Meta's breakdown_type and Google's location_type.",
    impressions: "The only metric. No spend, no clicks — the source has neither."
  }
}

-- INCREMENTAL, APPEND-ONLY, like every other DV360 mart. The Keboola
-- window is 14 days as of 2026-10-13; this accumulates past it.
--
-- See fct_dv360_daily for why the predicate loads "dates not already
-- present" rather than everything after MAX(date).

SELECT
  date,
  partner_id,
  advertiser_id,
  insertion_order_id,
  line_item_id,
  line_item_type,
  audience_category,
  SUM(impressions) AS impressions
FROM ${ref("stg_dv360_audience")}
WHERE date IS NOT NULL
  AND line_item_id IS NOT NULL
${when(incremental(),
  `AND date NOT IN (SELECT DISTINCT date FROM ${self()}
                    WHERE ${constants.allPartitions()})`)}
GROUP BY 1, 2, 3, 4, 5, 6, 7
